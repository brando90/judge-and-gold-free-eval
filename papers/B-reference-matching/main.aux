\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}RQ1: Can reference-similarity metrics grade individual solutions? No.}{4}{subsection.3.1}\protected@file@percent }
\newlabel{sec:classnull}{{3.1}{4}{RQ1: Can reference-similarity metrics grade individual solutions? No}{subsection.3.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}RQ2: Why not? Comparison scores are reference properties.}{4}{subsection.3.2}\protected@file@percent }
\newlabel{sec:mechanism}{{3.2}{4}{RQ2: Why not? Comparison scores are reference properties}{subsection.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The class-level null on the 60-item random label set.} Pearson correlation with blind human soundness, with bootstrap 95\% CIs, for every signal in the canonical analysis: comparison metrics in orange, verification signals in blue, and LLM judges (expensive comparison points) as hollow markers. \textbf  {Takeaway:} every comparison metric straddles zero or sits weakly negative (unigram-F1's CI excludes zero), while the deeper verification signals grade. The prefix-repair curve mean's $+0.79$ (Pearson) is comparable in magnitude to the human inter-rater ceiling (Spearman $0.79$, measured on a different shared block), but its signal is largely correctness-mediated (Section~\ref {sec:verify}): among correct-only solutions the curve mean drops to $+0.07$.}}{5}{figure.caption.6}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:class}{{1}{5}{\textbf {The class-level null on the 60-item random label set.} Pearson correlation with blind human soundness, with bootstrap 95\% CIs, for every signal in the canonical analysis: comparison metrics in orange, verification signals in blue, and LLM judges (expensive comparison points) as hollow markers. \textbf {Takeaway:} every comparison metric straddles zero or sits weakly negative (unigram-F1's CI excludes zero), while the deeper verification signals grade. The prefix-repair curve mean's $+0.79$ (Pearson) is comparable in magnitude to the human inter-rater ceiling (Spearman $0.79$, measured on a different shared block), but its signal is largely correctness-mediated (Section~\ref {sec:verify}): among correct-only solutions the curve mean drops to $+0.07$}{figure.caption.6}{}}
