\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {The full metric-class table.} Prediction-fit and weighted-similarity metrics rank on hard benchmarks and die or invert on saturated ones; raw overlap does not rank at all (its hard-benchmark inversion is a verbosity confound: controlling output length moves $-0.49$ to $-0.07$). Human columns are Pearson $r$ with bootstrap 95\% CIs on the 60-item set; gold-token logprob uses the $n{=}42$ subset with logprob available; the best human-anchored value is in bold. \textbf  {Takeaway:} no comparison metric grades against human soundness, and both verification signals do.}}{11}{table.caption.13}\protected@file@percent }
\newlabel{tab:classfull}{{3}{11}{\textbf {The full metric-class table.} Prediction-fit and weighted-similarity metrics rank on hard benchmarks and die or invert on saturated ones; raw overlap does not rank at all (its hard-benchmark inversion is a verbosity confound: controlling output length moves $-0.49$ to $-0.07$). Human columns are Pearson $r$ with bootstrap 95\% CIs on the 60-item set; gold-token logprob uses the $n{=}42$ subset with logprob available; the best human-anchored value is in bold. \textbf {Takeaway:} no comparison metric grades against human soundness, and both verification signals do}{table.caption.13}{}}
