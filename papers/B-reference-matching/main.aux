\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Teacher-forced accuracy is reference perplexity.} Per-solution \textsc  {TFA}{} against the reference's bits-per-character under the same model, pooled over 6{,}000 model--item pairs on \textsc  {MATH-500}, with the least-squares fit. \textbf  {Takeaway:} at $r = -0.895$, reference compressibility explains $80\%$ of pooled \textsc  {TFA}{} variance, so \textsc  {TFA}{} meters the reference rather than grading the solution. This pooled view is a corollary of the cross-family decomposition of Section~\ref {sec:mechanism}, which is the primary evidence.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:mechanism}{{2}{9}{\textbf {Teacher-forced accuracy is reference perplexity.} Per-solution \tfa {} against the reference's bits-per-character under the same model, pooled over 6{,}000 model--item pairs on \textsc {MATH-500}, with the least-squares fit. \textbf {Takeaway:} at $r = -0.895$, reference compressibility explains $80\%$ of pooled \tfa {} variance, so \tfa {} meters the reference rather than grading the solution. This pooled view is a corollary of the cross-family decomposition of Section~\ref {sec:mechanism}, which is the primary evidence}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Repairs fail, and the registered record says so in advance}{9}{subsection.3.4}\protected@file@percent }
\newlabel{sec:slate}{{3.4}{9}{Repairs fail, and the registered record says so in advance}{subsection.3.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {The boundary map: where reference matching ranks models.} Cross-family Spearman correlation between mean \textsc  {TFA}{} and accuracy (17 models; bootstrap CIs) per benchmark; the within-family column is the Qwen size ladder specifically, and best values are in bold. Within-family Spearmans are computed on ladders of three to five models, where the statistic takes only a few discrete values, so read signs and consistency rather than magnitudes; the \textsc  {SWE-bench} within-family entry is a four-model ladder and is a preliminary observation (Section~\ref {sec:ranking}). Ranking degrades from olympiad to saturated benchmarks, with code sitting mid-scale; the Qwen ladder stays positive everywhere, but across all families five of twelve ladders invert on the easiest benchmarks (Appendix~\ref {app:ladders}), a pattern we read as family style canceling inside a family and surviving across families, an interpretive attribution since output style is not directly measured here. \textbf  {Takeaway:} matching ranks models only on hard benchmarks with information-dense references, and cross-family comparison needs a shared style or a verifier.}}{10}{table.caption.10}\protected@file@percent }
\newlabel{tab:map}{{2}{10}{\textbf {The boundary map: where reference matching ranks models.} Cross-family Spearman correlation between mean \tfa {} and accuracy (17 models; bootstrap CIs) per benchmark; the within-family column is the Qwen size ladder specifically, and best values are in bold. Within-family Spearmans are computed on ladders of three to five models, where the statistic takes only a few discrete values, so read signs and consistency rather than magnitudes; the \textsc {SWE-bench} within-family entry is a four-model ladder and is a preliminary observation (Section~\ref {sec:ranking}). Ranking degrades from olympiad to saturated benchmarks, with code sitting mid-scale; the Qwen ladder stays positive everywhere, but across all families five of twelve ladders invert on the easiest benchmarks (Appendix~\ref {app:ladders}), a pattern we read as family style canceling inside a family and surviving across families, an interpretive attribution since output style is not directly measured here. \textbf {Takeaway:} matching ranks models only on hard benchmarks with information-dense references, and cross-family comparison needs a shared style or a verifier}{table.caption.10}{}}
