\newlabel{sec:ranking}{{3.3}{5}{RQ3: When can matching rank models? When references are worth predicting}{subsection.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Teacher-forced accuracy is reference perplexity.} Per-solution \textsc  {TFA}{} against the reference's bits-per-character under the same model, pooled over 6{,}000 model--item pairs on \textsc  {MATH-500}, with the least-squares fit. \textbf  {Takeaway:} at $r = -0.895$, reference compressibility explains $80\%$ of pooled \textsc  {TFA}{} variance, so \textsc  {TFA}{} meters the reference rather than grading the solution.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:mechanism}{{2}{6}{\textbf {Teacher-forced accuracy is reference perplexity.} Per-solution \tfa {} against the reference's bits-per-character under the same model, pooled over 6{,}000 model--item pairs on \textsc {MATH-500}, with the least-squares fit. \textbf {Takeaway:} at $r = -0.895$, reference compressibility explains $80\%$ of pooled \tfa {} variance, so \tfa {} meters the reference rather than grading the solution}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Repairs fail as predicted: the class is empty, not under-tuned}{6}{subsection.3.4}\protected@file@percent }
\newlabel{sec:slate}{{3.4}{6}{Repairs fail as predicted: the class is empty, not under-tuned}{subsection.3.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {The boundary map: where reference matching ranks models.} Cross-family Spearman correlation between mean \textsc  {TFA}{} and accuracy (17 models; bootstrap CIs) per benchmark; the within-family column is the Qwen size ladder specifically, and best values are in bold. Ranking degrades from olympiad to saturated benchmarks, with code sitting mid-scale; the Qwen ladder stays positive everywhere, but across all families five of twelve ladders invert on the easiest benchmarks (see body), because family style cancels inside a family and survives across families. \textbf  {Takeaway:} matching ranks models only on hard benchmarks with information-dense references, and cross-family comparison needs a shared style or a verifier.}}{7}{table.caption.8}\protected@file@percent }
\newlabel{tab:map}{{1}{7}{\textbf {The boundary map: where reference matching ranks models.} Cross-family Spearman correlation between mean \tfa {} and accuracy (17 models; bootstrap CIs) per benchmark; the within-family column is the Qwen size ladder specifically, and best values are in bold. Ranking degrades from olympiad to saturated benchmarks, with code sitting mid-scale; the Qwen ladder stays positive everywhere, but across all families five of twelve ladders invert on the easiest benchmarks (see body), because family style cancels inside a family and survives across families. \textbf {Takeaway:} matching ranks models only on hard benchmarks with information-dense references, and cross-family comparison needs a shared style or a verifier}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {The taxonomy makes correct advance predictions.} All four pre-registered predictions landed as called (the seven reweighting variants predate the registration protocol and are included for completeness); the strongest judge-free signal is in bold. The two verification-class entries are described in Section~\ref {sec:verify}; the prefix-repair headline is largely correctness-mediated (among correct-only solutions its curve mean is $+0.07$). \textbf  {Takeaway:} every comparison-class repair failed and every verification-class signal worked, exactly as registered before the data existed.}}{7}{table.caption.9}\protected@file@percent }
\newlabel{tab:slate}{{2}{7}{\textbf {The taxonomy makes correct advance predictions.} All four pre-registered predictions landed as called (the seven reweighting variants predate the registration protocol and are included for completeness); the strongest judge-free signal is in bold. The two verification-class entries are described in Section~\ref {sec:verify}; the prefix-repair headline is largely correctness-mediated (among correct-only solutions its curve mean is $+0.07$). \textbf {Takeaway:} every comparison-class repair failed and every verification-class signal worked, exactly as registered before the data existed}{table.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}RQ4: What does grade? Verification signals, with a correctness caveat.}{7}{subsection.3.5}\protected@file@percent }
\newlabel{sec:verify}{{3.5}{7}{RQ4: What does grade? Verification signals, with a correctness caveat}{subsection.3.5}{}}
\citation{companionA}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The two registered sweeps move in opposite directions, as the taxonomy predicts.} Left: up-weighting late reference tokens (the intuitive repair) decays \textsc  {TFA}'s twelve-model ranking signal past $\gamma {=}1$, through the answer-only-reference null and beyond it (the decay is a trend, not strictly monotone: $\gamma {=}1$ ticks up to $+0.15$ and last-16 sits above $\gamma {=}8$). Right: the prefix-repair signal rises with truncation depth, from a pure difficulty probe ($k{=}0$) to $+0.78$ against human soundness at $k{=}0.75$, with a curve mean of $+0.79$; among correct-only solutions the $k{=}0.75$ point is $+0.19$ and the curve mean $+0.07$ (Section~\ref {sec:verify}). \textbf  {Takeaway:} repairing a comparison metric destroys it while deepening a verification signal strengthens it, which is the class divide made visible.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:sweeps}{{3}{8}{\textbf {The two registered sweeps move in opposite directions, as the taxonomy predicts.} Left: up-weighting late reference tokens (the intuitive repair) decays \tfa 's twelve-model ranking signal past $\gamma {=}1$, through the answer-only-reference null and beyond it (the decay is a trend, not strictly monotone: $\gamma {=}1$ ticks up to $+0.15$ and last-16 sits above $\gamma {=}8$). Right: the prefix-repair signal rises with truncation depth, from a pure difficulty probe ($k{=}0$) to $+0.78$ against human soundness at $k{=}0.75$, with a curve mean of $+0.79$; among correct-only solutions the $k{=}0.75$ point is $+0.19$ and the curve mean $+0.07$ (Section~\ref {sec:verify}). \textbf {Takeaway:} repairing a comparison metric destroys it while deepening a verification signal strengthens it, which is the class divide made visible}{figure.caption.10}{}}
