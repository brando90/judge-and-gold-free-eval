\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}RQ4: What does grade? Nothing we tested beats the free answer-correct bit.}{9}{subsection.3.5}\protected@file@percent }
\newlabel{sec:verify}{{3.5}{9}{RQ4: What does grade? Nothing we tested beats the free answer-correct bit}{subsection.3.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {The registered slate: three of four advance predictions landed as called.} The position-weighted register predicted a null, and the observed $-0.37$ at last-four tokens is a sign flip, so that register was directionally wrong, not confirmed; the other three registered predictions landed as called (the seven reweighting variants predate the registration protocol and are included for completeness). The two verification-class entries are described in Section~\ref {sec:verify}; the prefix-repair curve's $+0.79$ sits below the free answer-correct bit's $+0.92$, and its partial correlation with soundness given correctness is $-0.10$, so it is not a headline grading signal. The register called the class divide but did not anticipate that the free bit would top the class. \textbf  {Takeaway:} every comparison-class repair failed and every verification-class signal out-correlated the comparison class, but none beat free answer correctness, and one comparison-class register called a null where the outcome was a sign flip.}}{10}{table.caption.9}\protected@file@percent }
\newlabel{tab:slate}{{2}{10}{\textbf {The registered slate: three of four advance predictions landed as called.} The position-weighted register predicted a null, and the observed $-0.37$ at last-four tokens is a sign flip, so that register was directionally wrong, not confirmed; the other three registered predictions landed as called (the seven reweighting variants predate the registration protocol and are included for completeness). The two verification-class entries are described in Section~\ref {sec:verify}; the prefix-repair curve's $+0.79$ sits below the free answer-correct bit's $+0.92$, and its partial correlation with soundness given correctness is $-0.10$, so it is not a headline grading signal. The register called the class divide but did not anticipate that the free bit would top the class. \textbf {Takeaway:} every comparison-class repair failed and every verification-class signal out-correlated the comparison class, but none beat free answer correctness, and one comparison-class register called a null where the outcome was a sign flip}{table.caption.9}{}}
\citation{companionA}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The two registered sweeps move in opposite directions, as the taxonomy predicts.} Left: up-weighting late reference tokens (the intuitive repair) decays \textsc  {TFA}'s twelve-model ranking signal past $\gamma {=}1$, through the answer-only-reference null and beyond it (the decay is a trend, not strictly monotone: $\gamma {=}1$ ticks up to $+0.15$ and last-16 sits above $\gamma {=}8$). Right: the prefix-repair signal rises with truncation depth in Pearson, from a pure difficulty probe ($k{=}0$) to $+0.78$ against human soundness at $k{=}0.75$, with a curve mean of $+0.79$; the dashed line marks the free answer-correct bit ($+0.92$), which the curve never reaches, and the Spearman profile is non-monotone (Section~\ref {sec:verify}). Among correct-only solutions the $k{=}0.75$ point is $+0.19$ and the curve mean $+0.07$, and the curve's partial correlation with soundness given correctness is $-0.10$. \textbf  {Takeaway:} repairing a comparison metric destroys it while deepening a verification signal strengthens it, but the strengthened signal only converges toward the free correctness bit from below.}}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:sweeps}{{3}{11}{\textbf {The two registered sweeps move in opposite directions, as the taxonomy predicts.} Left: up-weighting late reference tokens (the intuitive repair) decays \tfa 's twelve-model ranking signal past $\gamma {=}1$, through the answer-only-reference null and beyond it (the decay is a trend, not strictly monotone: $\gamma {=}1$ ticks up to $+0.15$ and last-16 sits above $\gamma {=}8$). Right: the prefix-repair signal rises with truncation depth in Pearson, from a pure difficulty probe ($k{=}0$) to $+0.78$ against human soundness at $k{=}0.75$, with a curve mean of $+0.79$; the dashed line marks the free answer-correct bit ($+0.92$), which the curve never reaches, and the Spearman profile is non-monotone (Section~\ref {sec:verify}). Among correct-only solutions the $k{=}0.75$ point is $+0.19$ and the curve mean $+0.07$, and the curve's partial correlation with soundness given correctness is $-0.10$. \textbf {Takeaway:} repairing a comparison metric destroys it while deepening a verification signal strengthens it, but the strengthened signal only converges toward the free correctness bit from below}{figure.caption.10}{}}
