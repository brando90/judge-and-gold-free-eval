\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Twin of Table~\ref {tab:classfull}: point estimates with bootstrap 95\% CIs and per-row caveats.} Columns as in Table~\ref {tab:classfull}, plus each signal's mechanism and the full variance split (item / family-style / residual shares). Notes: gold-token logprob uses the $n{=}42$ subset with logprob available; within-correct entries use $n{=}48$ ($n{=}32$ for logprob); the free bit is constant within the correct-only subset, so its within-correct entry is undefined by construction; unigram-F1's hard-benchmark inversion ($-0.49$) is a verbosity confound, moving to $-0.07$ when output length is controlled; the five-metric battery carries no multiplicity correction; the judge rows' within-correct caveats are in Sections~\ref {sec:verify} and~\ref {sec:limits}. Within-correct intervals come from the regenerated within-correct CI artifact, which carries both bootstrap and Fisher intervals with resample-retention counts. The judge row reports the Fisher interval because range restriction degenerates its bootstrap (3{,}465 of 4{,}000 resamples kept); the earlier quoted $[-0.25,-0.09]$ was an artifact of that degeneracy and carried no significance. Partial correlations on the anchor set: the completion-curve mean given the free bit is $-0.10$ $[-0.30,+0.22]$ against soundness, while the free bit given the curve retains $+0.77$ $[+0.55,+0.95]$.}}{21}{table.caption.18}\protected@file@percent }
\newlabel{tab:citwin}{{4}{21}{\textbf {Twin of Table~\ref {tab:classfull}: point estimates with bootstrap 95\% CIs and per-row caveats.} Columns as in Table~\ref {tab:classfull}, plus each signal's mechanism and the full variance split (item / family-style / residual shares). Notes: gold-token logprob uses the $n{=}42$ subset with logprob available; within-correct entries use $n{=}48$ ($n{=}32$ for logprob); the free bit is constant within the correct-only subset, so its within-correct entry is undefined by construction; unigram-F1's hard-benchmark inversion ($-0.49$) is a verbosity confound, moving to $-0.07$ when output length is controlled; the five-metric battery carries no multiplicity correction; the judge rows' within-correct caveats are in Sections~\ref {sec:verify} and~\ref {sec:limits}. Within-correct intervals come from the regenerated within-correct CI artifact, which carries both bootstrap and Fisher intervals with resample-retention counts. The judge row reports the Fisher interval because range restriction degenerates its bootstrap (3{,}465 of 4{,}000 resamples kept); the earlier quoted $[-0.25,-0.09]$ was an artifact of that degeneracy and carried no significance. Partial correlations on the anchor set: the completion-curve mean given the free bit is $-0.10$ $[-0.30,+0.22]$ against soundness, while the free bit given the curve retains $+0.77$ $[+0.55,+0.95]$}{table.caption.18}{}}
