\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {The prediction ledger: four of six registered predictions landed as called, with one sign flip and one falsification on record.} Each row is one pre-registered directional prediction, committed to the repository before its data were generated, with its outcome and verdict. The position-weighted register predicted a null, and the observed $-0.37$ at last-four tokens is a sign flip, so that register was directionally wrong, not confirmed. The completer-strength register (P-C1) predicted a middle band of completer strength in three legs: washout at 1.5B, gains through 7B, little at 32B. The washout-at-1.5B leg is decisively falsified, since the 1.5B completer already reaches $+0.78$; the gains-through-7B and little-at-32B legs are point-wise compatible with the observed ordering but flat within overlapping CIs, so the register as a whole is falsified while corroborating the free-bit mechanism (Section~\ref {sec:verify}). The class-level divide, verification signals carrying signal where matching carries none, was called in advance, but the register did not anticipate that the free bit would top the class. Two notes: seven earlier reweighting variants (IDF, surprisal, masking, \dots  ) predate the registration protocol and all came out $\le 0$; the length-matched uninformative-reference control (P-L1) ran after its prediction was committed and landed as predicted, with the certified item-level paired delta in Section~\ref {sec:mechanism} and both evidence levels in Table~\ref {tab:robust}.}}{11}{table.caption.11}\protected@file@percent }
\newlabel{tab:ledger}{{3}{11}{\textbf {The prediction ledger: four of six registered predictions landed as called, with one sign flip and one falsification on record.} Each row is one pre-registered directional prediction, committed to the repository before its data were generated, with its outcome and verdict. The position-weighted register predicted a null, and the observed $-0.37$ at last-four tokens is a sign flip, so that register was directionally wrong, not confirmed. The completer-strength register (P-C1) predicted a middle band of completer strength in three legs: washout at 1.5B, gains through 7B, little at 32B. The washout-at-1.5B leg is decisively falsified, since the 1.5B completer already reaches $+0.78$; the gains-through-7B and little-at-32B legs are point-wise compatible with the observed ordering but flat within overlapping CIs, so the register as a whole is falsified while corroborating the free-bit mechanism (Section~\ref {sec:verify}). The class-level divide, verification signals carrying signal where matching carries none, was called in advance, but the register did not anticipate that the free bit would top the class. Two notes: seven earlier reweighting variants (IDF, surprisal, masking, \dots ) predate the registration protocol and all came out $\le 0$; the length-matched uninformative-reference control (P-L1) ran after its prediction was committed and landed as predicted, with the certified item-level paired delta in Section~\ref {sec:mechanism} and both evidence levels in Table~\ref {tab:robust}}{table.caption.11}{}}
\citation{companionA}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The two registered sweeps move in opposite directions, as the taxonomy predicts.} Left: up-weighting late reference tokens (the intuitive repair) decays \textsc  {TFA}'s twelve-model ranking signal past $\gamma {=}1$, through the answer-only-reference null and beyond it (the decay is a trend, not strictly monotone: $\gamma {=}1$ ticks up to $+0.15$ and last-16 sits above $\gamma {=}8$). Right: the completion-curve signal rises with truncation depth in Pearson, from a pure difficulty probe ($k{=}0$) to $+0.78$ against human soundness at $k{=}0.75$; the dashed line marks the free bit ($+0.92$), which the curve never reaches, and the Spearman profile is non-monotone (Table~\ref {tab:robust}). \textbf  {Takeaway:} repairing a matching metric destroys it while deepening a verification signal strengthens it, but the strengthened signal only converges toward the free bit from below.}}{12}{figure.caption.12}\protected@file@percent }
\newlabel{fig:sweeps}{{3}{12}{\textbf {The two registered sweeps move in opposite directions, as the taxonomy predicts.} Left: up-weighting late reference tokens (the intuitive repair) decays \tfa 's twelve-model ranking signal past $\gamma {=}1$, through the answer-only-reference null and beyond it (the decay is a trend, not strictly monotone: $\gamma {=}1$ ticks up to $+0.15$ and last-16 sits above $\gamma {=}8$). Right: the completion-curve signal rises with truncation depth in Pearson, from a pure difficulty probe ($k{=}0$) to $+0.78$ against human soundness at $k{=}0.75$; the dashed line marks the free bit ($+0.92$), which the curve never reaches, and the Spearman profile is non-monotone (Table~\ref {tab:robust}). \textbf {Takeaway:} repairing a matching metric destroys it while deepening a verification signal strengthens it, but the strengthened signal only converges toward the free bit from below}{figure.caption.12}{}}
