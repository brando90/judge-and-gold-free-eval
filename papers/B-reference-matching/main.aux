\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The class-level null on the 60-item random label set.} Pearson correlation with blind human soundness, with bootstrap 95\% CIs, for every signal in the canonical analysis: comparison metrics in orange, verification signals in blue, and LLM judges (expensive comparison points) as hollow markers. \textbf  {Takeaway:} every comparison metric straddles zero or sits weakly negative (unigram-F1's CI excludes zero, uncorrected for the five-metric battery), while the verification signals carry signal; the top of the field, however, is the free answer-correct bit at $+0.92$ $[+0.78, +0.99]$ (\texttt  {papers/analysis/free\_baseline.json}), which no other cheap signal beats. Dotted lines mark the inter-rater Pearson $0.80$ and the implied single-rater ceiling $0.89$; both come from an $n{=}20$ cross-schema block with a wide interval (roughly $[0.55, 0.92]$ on the inter-rater figure), so ceiling comparisons are indicative only (Section~\ref {sec:setup}). The prefix-repair curve mean's $+0.79$ sits below the free bit, its Spearman is $+0.41$, and its partial correlation with soundness given correctness is $-0.10$ $[-0.30, +0.22]$ (Section~\ref {sec:verify}).}}{6}{figure.caption.6}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:class}{{1}{6}{\textbf {The class-level null on the 60-item random label set.} Pearson correlation with blind human soundness, with bootstrap 95\% CIs, for every signal in the canonical analysis: comparison metrics in orange, verification signals in blue, and LLM judges (expensive comparison points) as hollow markers. \textbf {Takeaway:} every comparison metric straddles zero or sits weakly negative (unigram-F1's CI excludes zero, uncorrected for the five-metric battery), while the verification signals carry signal; the top of the field, however, is the free answer-correct bit at $+0.92$ $[+0.78, +0.99]$ (\texttt {papers/analysis/free\_baseline.json}), which no other cheap signal beats. Dotted lines mark the inter-rater Pearson $0.80$ and the implied single-rater ceiling $0.89$; both come from an $n{=}20$ cross-schema block with a wide interval (roughly $[0.55, 0.92]$ on the inter-rater figure), so ceiling comparisons are indicative only (Section~\ref {sec:setup}). The prefix-repair curve mean's $+0.79$ sits below the free bit, its Spearman is $+0.41$, and its partial correlation with soundness given correctness is $-0.10$ $[-0.30, +0.22]$ (Section~\ref {sec:verify})}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}RQ3: When can matching rank models? When references are worth predicting.}{7}{subsection.3.3}\protected@file@percent }
\newlabel{sec:ranking}{{3.3}{7}{RQ3: When can matching rank models? When references are worth predicting}{subsection.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Teacher-forced accuracy is reference perplexity.} Per-solution \textsc  {TFA}{} against the reference's bits-per-character under the same model, pooled over 6{,}000 model--item pairs on \textsc  {MATH-500}, with the least-squares fit. \textbf  {Takeaway:} at $r = -0.895$, reference compressibility explains $80\%$ of pooled \textsc  {TFA}{} variance, so \textsc  {TFA}{} meters the reference rather than grading the solution. This pooled view is a corollary of the cross-family decomposition of Section~\ref {sec:mechanism}, which is the primary evidence.}}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:mechanism}{{2}{8}{\textbf {Teacher-forced accuracy is reference perplexity.} Per-solution \tfa {} against the reference's bits-per-character under the same model, pooled over 6{,}000 model--item pairs on \textsc {MATH-500}, with the least-squares fit. \textbf {Takeaway:} at $r = -0.895$, reference compressibility explains $80\%$ of pooled \tfa {} variance, so \tfa {} meters the reference rather than grading the solution. This pooled view is a corollary of the cross-family decomposition of Section~\ref {sec:mechanism}, which is the primary evidence}{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {The boundary map: where reference matching ranks models.} Cross-family Spearman correlation between mean \textsc  {TFA}{} and accuracy (17 models; bootstrap CIs) per benchmark; the within-family column is the Qwen size ladder specifically, and best values are in bold. Within-family Spearmans are computed on ladders of three to five models, where the statistic takes only a few discrete values, so read signs and consistency rather than magnitudes; the \textsc  {SWE-bench} within-family entry is a four-model ladder and is a preliminary observation (Section~\ref {sec:ranking}). Ranking degrades from olympiad to saturated benchmarks, with code sitting mid-scale; the Qwen ladder stays positive everywhere, but across all families five of twelve ladders invert on the easiest benchmarks (Appendix~\ref {app:ladders}), because family style cancels inside a family and survives across families. \textbf  {Takeaway:} matching ranks models only on hard benchmarks with information-dense references, and cross-family comparison needs a shared style or a verifier.}}{9}{table.caption.8}\protected@file@percent }
\newlabel{tab:map}{{1}{9}{\textbf {The boundary map: where reference matching ranks models.} Cross-family Spearman correlation between mean \tfa {} and accuracy (17 models; bootstrap CIs) per benchmark; the within-family column is the Qwen size ladder specifically, and best values are in bold. Within-family Spearmans are computed on ladders of three to five models, where the statistic takes only a few discrete values, so read signs and consistency rather than magnitudes; the \textsc {SWE-bench} within-family entry is a four-model ladder and is a preliminary observation (Section~\ref {sec:ranking}). Ranking degrades from olympiad to saturated benchmarks, with code sitting mid-scale; the Qwen ladder stays positive everywhere, but across all families five of twelve ladders invert on the easiest benchmarks (Appendix~\ref {app:ladders}), because family style cancels inside a family and survives across families. \textbf {Takeaway:} matching ranks models only on hard benchmarks with information-dense references, and cross-family comparison needs a shared style or a verifier}{table.caption.8}{}}
