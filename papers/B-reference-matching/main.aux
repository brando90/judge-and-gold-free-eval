\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The class-level null on the 60-item random label set.} Pearson correlation with blind human soundness, with bootstrap 95\% CIs, for every signal in the canonical analysis: comparison metrics in orange, verification signals in blue, and LLM judges (expensive comparison points) as hollow markers. \textbf  {Takeaway:} every comparison metric straddles zero or sits weakly negative (unigram-F1's CI excludes zero, uncorrected for the five-metric battery), while the verification signals carry signal; the top of the field, however, is the free answer-correct bit at $+0.92$ $[+0.78, +0.99]$ (\texttt  {papers/analysis/free\_baseline.json}), which no other cheap signal beats. Dotted lines mark the inter-rater Pearson $0.80$ and the implied single-rater ceiling $0.89$ from the original $n{=}20$ cross-schema block; a same-rubric hypothesis-blind rater on $n{=}30$ items gives an agreeing estimate ($0.83$ $[0.44, 0.97]$, implied ceiling $0.91$), and both intervals are wide, so ceiling comparisons are indicative only (Section~\ref {sec:setup}). The prefix-repair curve mean's $+0.79$ sits below the free bit, its Spearman is $+0.41$, and its partial correlation with soundness given correctness is $-0.10$ $[-0.30, +0.22]$ (Section~\ref {sec:verify}).}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:class}{{1}{7}{\textbf {The class-level null on the 60-item random label set.} Pearson correlation with blind human soundness, with bootstrap 95\% CIs, for every signal in the canonical analysis: comparison metrics in orange, verification signals in blue, and LLM judges (expensive comparison points) as hollow markers. \textbf {Takeaway:} every comparison metric straddles zero or sits weakly negative (unigram-F1's CI excludes zero, uncorrected for the five-metric battery), while the verification signals carry signal; the top of the field, however, is the free answer-correct bit at $+0.92$ $[+0.78, +0.99]$ (\texttt {papers/analysis/free\_baseline.json}), which no other cheap signal beats. Dotted lines mark the inter-rater Pearson $0.80$ and the implied single-rater ceiling $0.89$ from the original $n{=}20$ cross-schema block; a same-rubric hypothesis-blind rater on $n{=}30$ items gives an agreeing estimate ($0.83$ $[0.44, 0.97]$, implied ceiling $0.91$), and both intervals are wide, so ceiling comparisons are indicative only (Section~\ref {sec:setup}). The prefix-repair curve mean's $+0.79$ sits below the free bit, its Spearman is $+0.41$, and its partial correlation with soundness given correctness is $-0.10$ $[-0.30, +0.22]$ (Section~\ref {sec:verify})}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}RQ3: When can matching rank models? When references are worth predicting.}{8}{subsection.3.3}\protected@file@percent }
\newlabel{sec:ranking}{{3.3}{8}{RQ3: When can matching rank models? When references are worth predicting}{subsection.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Teacher-forced accuracy is reference perplexity.} Per-solution \textsc  {TFA}{} against the reference's bits-per-character under the same model, pooled over 6{,}000 model--item pairs on \textsc  {MATH-500}, with the least-squares fit. \textbf  {Takeaway:} at $r = -0.895$, reference compressibility explains $80\%$ of pooled \textsc  {TFA}{} variance, so \textsc  {TFA}{} meters the reference rather than grading the solution. This pooled view is a corollary of the cross-family decomposition of Section~\ref {sec:mechanism}, which is the primary evidence.}}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:mechanism}{{2}{9}{\textbf {Teacher-forced accuracy is reference perplexity.} Per-solution \tfa {} against the reference's bits-per-character under the same model, pooled over 6{,}000 model--item pairs on \textsc {MATH-500}, with the least-squares fit. \textbf {Takeaway:} at $r = -0.895$, reference compressibility explains $80\%$ of pooled \tfa {} variance, so \tfa {} meters the reference rather than grading the solution. This pooled view is a corollary of the cross-family decomposition of Section~\ref {sec:mechanism}, which is the primary evidence}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Repairs fail: the class is empty, not under-tuned}{9}{subsection.3.4}\protected@file@percent }
\newlabel{sec:slate}{{3.4}{9}{Repairs fail: the class is empty, not under-tuned}{subsection.3.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {The boundary map: where reference matching ranks models.} Cross-family Spearman correlation between mean \textsc  {TFA}{} and accuracy (17 models; bootstrap CIs) per benchmark; the within-family column is the Qwen size ladder specifically, and best values are in bold. Within-family Spearmans are computed on ladders of three to five models, where the statistic takes only a few discrete values, so read signs and consistency rather than magnitudes; the \textsc  {SWE-bench} within-family entry is a four-model ladder and is a preliminary observation (Section~\ref {sec:ranking}). Ranking degrades from olympiad to saturated benchmarks, with code sitting mid-scale; the Qwen ladder stays positive everywhere, but across all families five of twelve ladders invert on the easiest benchmarks (Appendix~\ref {app:ladders}), because family style cancels inside a family and survives across families. \textbf  {Takeaway:} matching ranks models only on hard benchmarks with information-dense references, and cross-family comparison needs a shared style or a verifier.}}{10}{table.caption.9}\protected@file@percent }
\newlabel{tab:map}{{2}{10}{\textbf {The boundary map: where reference matching ranks models.} Cross-family Spearman correlation between mean \tfa {} and accuracy (17 models; bootstrap CIs) per benchmark; the within-family column is the Qwen size ladder specifically, and best values are in bold. Within-family Spearmans are computed on ladders of three to five models, where the statistic takes only a few discrete values, so read signs and consistency rather than magnitudes; the \textsc {SWE-bench} within-family entry is a four-model ladder and is a preliminary observation (Section~\ref {sec:ranking}). Ranking degrades from olympiad to saturated benchmarks, with code sitting mid-scale; the Qwen ladder stays positive everywhere, but across all families five of twelve ladders invert on the easiest benchmarks (Appendix~\ref {app:ladders}), because family style cancels inside a family and survives across families. \textbf {Takeaway:} matching ranks models only on hard benchmarks with information-dense references, and cross-family comparison needs a shared style or a verifier}{table.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}RQ4: What does grade? Nothing we tested beats the free answer-correct bit.}{10}{subsection.3.5}\protected@file@percent }
\newlabel{sec:verify}{{3.5}{10}{RQ4: What does grade? Nothing we tested beats the free answer-correct bit}{subsection.3.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {The registered slate: three of four advance predictions landed as called.} The position-weighted register predicted a null, and the observed $-0.37$ at last-four tokens is a sign flip, so that register was directionally wrong, not confirmed; the other three registered predictions landed as called (the seven reweighting variants predate the registration protocol and are included for completeness). The two verification-class entries are described in Section~\ref {sec:verify}; the prefix-repair curve's $+0.79$ sits below the free answer-correct bit's $+0.92$, and its partial correlation with soundness given correctness is $-0.10$, so it is not a headline grading signal. The register called the class divide but did not anticipate that the free bit would top the class. A fifth register, the completer-strength middle band (P-C1), was run after this slate and falsified (Section~\ref {sec:verify}), so the full registered record is three hits, one sign flip, and one falsification. \textbf  {Takeaway:} every comparison-class repair failed and every verification-class signal out-correlated the comparison class, but none beat free answer correctness, and one comparison-class register called a null where the outcome was a sign flip.}}{11}{table.caption.10}\protected@file@percent }
\newlabel{tab:slate}{{3}{11}{\textbf {The registered slate: three of four advance predictions landed as called.} The position-weighted register predicted a null, and the observed $-0.37$ at last-four tokens is a sign flip, so that register was directionally wrong, not confirmed; the other three registered predictions landed as called (the seven reweighting variants predate the registration protocol and are included for completeness). The two verification-class entries are described in Section~\ref {sec:verify}; the prefix-repair curve's $+0.79$ sits below the free answer-correct bit's $+0.92$, and its partial correlation with soundness given correctness is $-0.10$, so it is not a headline grading signal. The register called the class divide but did not anticipate that the free bit would top the class. A fifth register, the completer-strength middle band (P-C1), was run after this slate and falsified (Section~\ref {sec:verify}), so the full registered record is three hits, one sign flip, and one falsification. \textbf {Takeaway:} every comparison-class repair failed and every verification-class signal out-correlated the comparison class, but none beat free answer correctness, and one comparison-class register called a null where the outcome was a sign flip}{table.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The two registered sweeps move in opposite directions, as the taxonomy predicts.} Left: up-weighting late reference tokens (the intuitive repair) decays \textsc  {TFA}'s twelve-model ranking signal past $\gamma {=}1$, through the answer-only-reference null and beyond it (the decay is a trend, not strictly monotone: $\gamma {=}1$ ticks up to $+0.15$ and last-16 sits above $\gamma {=}8$). Right: the prefix-repair signal rises with truncation depth in Pearson, from a pure difficulty probe ($k{=}0$) to $+0.78$ against human soundness at $k{=}0.75$, with a curve mean of $+0.79$; the dashed line marks the free answer-correct bit ($+0.92$), which the curve never reaches, and the Spearman profile is non-monotone (Section~\ref {sec:verify}). Among correct-only solutions the $k{=}0.75$ point is $+0.19$ and the curve mean $+0.07$, and the curve's partial correlation with soundness given correctness is $-0.10$. \textbf  {Takeaway:} repairing a comparison metric destroys it while deepening a verification signal strengthens it, but the strengthened signal only converges toward the free correctness bit from below.}}{12}{figure.caption.11}\protected@file@percent }
\newlabel{fig:sweeps}{{3}{12}{\textbf {The two registered sweeps move in opposite directions, as the taxonomy predicts.} Left: up-weighting late reference tokens (the intuitive repair) decays \tfa 's twelve-model ranking signal past $\gamma {=}1$, through the answer-only-reference null and beyond it (the decay is a trend, not strictly monotone: $\gamma {=}1$ ticks up to $+0.15$ and last-16 sits above $\gamma {=}8$). Right: the prefix-repair signal rises with truncation depth in Pearson, from a pure difficulty probe ($k{=}0$) to $+0.78$ against human soundness at $k{=}0.75$, with a curve mean of $+0.79$; the dashed line marks the free answer-correct bit ($+0.92$), which the curve never reaches, and the Spearman profile is non-monotone (Section~\ref {sec:verify}). Among correct-only solutions the $k{=}0.75$ point is $+0.19$ and the curve mean $+0.07$, and the curve's partial correlation with soundness given correctness is $-0.10$. \textbf {Takeaway:} repairing a comparison metric destroys it while deepening a verification signal strengthens it, but the strengthened signal only converges toward the free correctness bit from below}{figure.caption.11}{}}
