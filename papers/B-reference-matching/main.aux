\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The class-level null on the anchor set.} Pearson correlation with blind human soundness, with bootstrap 95\% CIs, for every signal in the canonical analysis: matching metrics in orange, verification signals in blue, and LLM judges (expensive comparison points) as hollow markers. \textbf  {Takeaway:} every matching metric straddles zero or sits weakly negative (unigram-F1's CI excludes zero, uncorrected for the five-metric battery), while the verification signals carry signal; the top of the field, however, is the free bit at $+0.92$, which no other cheap signal beats. Dotted lines mark the inter-rater agreement and implied single-rater ceiling; both reliability estimates have wide intervals, so ceiling comparisons are indicative only (Appendix~\ref {app:ceiling}).}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:class}{{1}{7}{\textbf {The class-level null on the anchor set.} Pearson correlation with blind human soundness, with bootstrap 95\% CIs, for every signal in the canonical analysis: matching metrics in orange, verification signals in blue, and LLM judges (expensive comparison points) as hollow markers. \textbf {Takeaway:} every matching metric straddles zero or sits weakly negative (unigram-F1's CI excludes zero, uncorrected for the five-metric battery), while the verification signals carry signal; the top of the field, however, is the free bit at $+0.92$, which no other cheap signal beats. Dotted lines mark the inter-rater agreement and implied single-rater ceiling; both reliability estimates have wide intervals, so ceiling comparisons are indicative only (Appendix~\ref {app:ceiling})}{figure.caption.8}{}}
