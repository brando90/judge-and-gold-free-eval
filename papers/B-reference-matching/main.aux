\newlabel{fig:class}{{1}{4}{\textbf {The class-level null on the 60-item random label set.} Pearson correlation with blind human soundness, with bootstrap 95\% CIs, for every signal in the canonical analysis: comparison metrics in orange, verification signals in blue, and LLM judges (expensive comparison points) as hollow markers. \textbf {Takeaway:} every comparison metric straddles zero while every verification signal grades, and the prefix-repair curve mean sits at the human inter-rater ceiling of $0.79$}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}RQ2: Why not? Comparison scores are reference properties.}{4}{subsection.3.2}\protected@file@percent }
\newlabel{sec:mechanism}{{3.2}{4}{RQ2: Why not? Comparison scores are reference properties}{subsection.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Teacher-forced accuracy is reference perplexity.} Per-solution \textsc  {TFA}{} against the reference's bits-per-character under the same model, pooled over 6{,}000 model--item pairs on \textsc  {MATH-500}, with the least-squares fit. \textbf  {Takeaway:} at $r = -0.895$, reference compressibility explains $80\%$ of pooled \textsc  {TFA}{} variance, so \textsc  {TFA}{} meters the reference rather than grading the solution.}}{5}{figure.caption.7}\protected@file@percent }
\newlabel{fig:mechanism}{{2}{5}{\textbf {Teacher-forced accuracy is reference perplexity.} Per-solution \tfa {} against the reference's bits-per-character under the same model, pooled over 6{,}000 model--item pairs on \textsc {MATH-500}, with the least-squares fit. \textbf {Takeaway:} at $r = -0.895$, reference compressibility explains $80\%$ of pooled \tfa {} variance, so \tfa {} meters the reference rather than grading the solution}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}RQ3: When can matching rank models? When references are worth predicting.}{5}{subsection.3.3}\protected@file@percent }
\newlabel{sec:ranking}{{3.3}{5}{RQ3: When can matching rank models? When references are worth predicting}{subsection.3.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {The boundary map: where reference matching ranks models.} Cross-family Spearman correlation between mean \textsc  {TFA}{} and accuracy (17 models; bootstrap CIs), and the Qwen size-ladder correlation as the within-family column, per benchmark; best values in bold. Ranking degrades from olympiad to saturated benchmarks, with code sitting mid-scale, and within-family ladders survive everywhere the pooled comparison does not, because family style cancels inside a family and survives across families. \textbf  {Takeaway:} matching ranks models only on hard benchmarks with information-dense references, and cross-family comparison needs a shared style or a verifier.}}{6}{table.caption.8}\protected@file@percent }
\newlabel{tab:map}{{1}{6}{\textbf {The boundary map: where reference matching ranks models.} Cross-family Spearman correlation between mean \tfa {} and accuracy (17 models; bootstrap CIs), and the Qwen size-ladder correlation as the within-family column, per benchmark; best values in bold. Ranking degrades from olympiad to saturated benchmarks, with code sitting mid-scale, and within-family ladders survive everywhere the pooled comparison does not, because family style cancels inside a family and survives across families. \textbf {Takeaway:} matching ranks models only on hard benchmarks with information-dense references, and cross-family comparison needs a shared style or a verifier}{table.caption.8}{}}
\newlabel{sec:slate}{{3.3}{6}{Repairs fail as predicted: the class is empty, not under-tuned}{section*.9}{}}
\@writefile{toc}{\contentsline {paragraph}{Repairs fail as predicted: the class is empty, not under-tuned.}{6}{section*.9}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {The taxonomy makes correct advance predictions.} All four pre-registered predictions landed as called (the seven reweighting variants predate the registration protocol and are included for completeness); the strongest judge-free signal is in bold. The two verification-class entries are described in Section~\ref {sec:verify}. \textbf  {Takeaway:} every comparison-class repair failed and every verification-class signal worked, exactly as registered before the data existed.}}{7}{table.caption.10}\protected@file@percent }
\newlabel{tab:slate}{{2}{7}{\textbf {The taxonomy makes correct advance predictions.} All four pre-registered predictions landed as called (the seven reweighting variants predate the registration protocol and are included for completeness); the strongest judge-free signal is in bold. The two verification-class entries are described in Section~\ref {sec:verify}. \textbf {Takeaway:} every comparison-class repair failed and every verification-class signal worked, exactly as registered before the data existed}{table.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The two registered sweeps move in opposite directions, as the taxonomy predicts.} Left: up-weighting late reference tokens (the intuitive repair) decays \textsc  {TFA}'s twelve-model ranking signal monotonically past $\gamma {=}1$, through the answer-only-reference null and beyond it. Right: the prefix-repair signal rises monotonically with truncation depth, from a pure difficulty probe ($k{=}0$) to $+0.78$ against human soundness at $k{=}0.75$, with a curve mean of $+0.79$. \textbf  {Takeaway:} repairing a comparison metric destroys it while deepening a verification signal strengthens it, which is the class divide made visible.}}{7}{figure.caption.11}\protected@file@percent }
\newlabel{fig:sweeps}{{3}{7}{\textbf {The two registered sweeps move in opposite directions, as the taxonomy predicts.} Left: up-weighting late reference tokens (the intuitive repair) decays \tfa 's twelve-model ranking signal monotonically past $\gamma {=}1$, through the answer-only-reference null and beyond it. Right: the prefix-repair signal rises monotonically with truncation depth, from a pure difficulty probe ($k{=}0$) to $+0.78$ against human soundness at $k{=}0.75$, with a curve mean of $+0.79$. \textbf {Takeaway:} repairing a comparison metric destroys it while deepening a verification signal strengthens it, which is the class divide made visible}{figure.caption.11}{}}
