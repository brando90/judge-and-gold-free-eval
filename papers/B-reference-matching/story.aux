\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Takeaway: between $83\%$ and $92\%$ of per-solution \textsc  {TFA}{} variance beyond model level is an item effect that replicates across four model families, moves only within a narrow range when any single model is deleted, and is therefore a property of the reference text.} Sum-of-squares shares from a fixed-effects decomposition of the model-centered score grid, with the item effect estimated as the unweighted cross-family mean of the model-centered scores; item-level bootstrap 95\% CIs (widths $0.03$--$0.04$) and the range of the share under deletion of any single model. The family-style column is the family-specific share where reported; it runs roughly two-and-a-half-fold larger on saturated benchmarks than on olympiad ones, which is the channel behind the saturated-side inversions of Section~\ref {sec:p3}. The same structure appears in code ($78\%$ item, $8\%$ family, $14\%$ residual) and, attenuated, in every similarity metric ($69\%$ TF-IDF, $\sim $$70\%$ embeddings, $45$--$55\%$ unigram-F1; Table~\ref {tab:class}).}}{8}{table.caption.18}\protected@file@percent }
\newlabel{tab:decomp}{{4}{8}{\textbf {Takeaway: between $83\%$ and $92\%$ of per-solution \tfa {} variance beyond model level is an item effect that replicates across four model families, moves only within a narrow range when any single model is deleted, and is therefore a property of the reference text.} Sum-of-squares shares from a fixed-effects decomposition of the model-centered score grid, with the item effect estimated as the unweighted cross-family mean of the model-centered scores; item-level bootstrap 95\% CIs (widths $0.03$--$0.04$) and the range of the share under deletion of any single model. The family-style column is the family-specific share where reported; it runs roughly two-and-a-half-fold larger on saturated benchmarks than on olympiad ones, which is the channel behind the saturated-side inversions of Section~\ref {sec:p3}. The same structure appears in code ($78\%$ item, $8\%$ family, $14\%$ residual) and, attenuated, in every similarity metric ($69\%$ TF-IDF, $\sim $$70\%$ embeddings, $45$--$55\%$ unigram-F1; Table~\ref {tab:class})}{table.caption.18}{}}
\@writefile{toc}{\contentsline {paragraph}{The result: the decomposition.}{8}{section*.19}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The result: the interventions.}{8}{section*.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Takeaway: to first order, teacher-forced accuracy is reference perplexity. At $r = -0.895$ pooled over 6{,}000 model--item pairs, reference compressibility explains $80\%$ of pooled \textsc  {TFA}{} variance, so the metric meters the reference rather than grading the solution.} Per-solution \textsc  {TFA}{} against the reference's bits-per-character under the same model on \textsc  {MATH-500}, with the least-squares fit. This pooled view is a corollary of the cross-family decomposition (Table~\ref {tab:decomp}), which is the primary evidence; taken alone it would be partially tautological, since both statistics summarize the same model's prediction fit to the same text.}}{9}{figure.caption.20}\protected@file@percent }
\newlabel{fig:mechanism}{{2}{9}{\textbf {Takeaway: to first order, teacher-forced accuracy is reference perplexity. At $r = -0.895$ pooled over 6{,}000 model--item pairs, reference compressibility explains $80\%$ of pooled \tfa {} variance, so the metric meters the reference rather than grading the solution.} Per-solution \tfa {} against the reference's bits-per-character under the same model on \textsc {MATH-500}, with the least-squares fit. This pooled view is a corollary of the cross-family decomposition (Table~\ref {tab:decomp}), which is the primary evidence; taken alone it would be partially tautological, since both statistics summarize the same model's prediction fit to the same text}{figure.caption.20}{}}
