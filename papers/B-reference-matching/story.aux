\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Takeaway: the boundary map. Mean \textsc  {TFA}{} ranks models on hard benchmarks with information-dense references, degrades through code, and inverts in sign on saturated grade-school data, exactly where the reference stops being worth predicting.} Cross-family Spearman correlation between mean \textsc  {TFA}{} and accuracy per benchmark (11--17 models by row; \textsc  {Omni-MATH} uses a seven-model sweep and \textsc  {SWE-bench} eight coder models; bootstrap 95\% CIs); the within-family column is the Qwen size ladder specifically. Within-family Spearmans sit on ladders of three to five models, so the statistic takes only a few discrete values: read signs and consistency, not magnitudes. The saturated-benchmark intervals are wide and straddle zero, so the sign inversion is a point-estimate trend; the robust statement is the ladder count of Section~\ref {sec:p3}, twelve of twelve hard-side ladders positive and five of twelve saturated ladders inverting. The \textsc  {SWE-bench} within-family entry is a four-model ladder and a preliminary observation.}}{5}{table.caption.6}\protected@file@percent }
\newlabel{tab:map}{{2}{5}{\textbf {Takeaway: the boundary map. Mean \tfa {} ranks models on hard benchmarks with information-dense references, degrades through code, and inverts in sign on saturated grade-school data, exactly where the reference stops being worth predicting.} Cross-family Spearman correlation between mean \tfa {} and accuracy per benchmark (11--17 models by row; \textsc {Omni-MATH} uses a seven-model sweep and \textsc {SWE-bench} eight coder models; bootstrap 95\% CIs); the within-family column is the Qwen size ladder specifically. Within-family Spearmans sit on ladders of three to five models, so the statistic takes only a few discrete values: read signs and consistency, not magnitudes. The saturated-benchmark intervals are wide and straddle zero, so the sign inversion is a point-estimate trend; the robust statement is the ladder count of Section~\ref {sec:p3}, twelve of twelve hard-side ladders positive and five of twelve saturated ladders inverting. The \textsc {SWE-bench} within-family entry is a four-model ladder and a preliminary observation}{table.caption.6}{}}
\@writefile{toc}{\contentsline {paragraph}{Verification signals.}{5}{section*.9}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Ground truth.}{5}{section*.10}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Takeaway: no cheap signal grades beyond the free correctness bit. Every matching metric, primary or stress-test, lands in $[-0.33, +0.14]$ against blind human soundness, and the one escape reads only final answers.} Each row is one signal on the 60-item anchor set: Pearson (with bootstrap 95\% CI) and Spearman against blind human soundness, the within-correct correlation (the margin a grader must win), the model-ranking Spearman on hard versus saturated benchmarks, and the share of per-solution variance owned by the item (the reference). Gold-token logprob uses the $n{=}42$ subset with logprob available; within-correct entries use $n{=}48$ ($n{=}32$ for logprob); the free bit is constant within the correct-only subset, so its within-correct entry is undefined by construction. Unigram-F1's hard-benchmark inversion ($-0.49$) is a verbosity confound, moving to $-0.07$ when output length is controlled. The judge row reports the Fisher interval because range restriction degenerates its bootstrap; the three post-hoc rows were added in response to review and carry no registration weight. The five-metric battery carries no multiplicity correction.}}{6}{table.caption.14}\protected@file@percent }
\newlabel{tab:class}{{3}{6}{\textbf {Takeaway: no cheap signal grades beyond the free correctness bit. Every matching metric, primary or stress-test, lands in $[-0.33, +0.14]$ against blind human soundness, and the one escape reads only final answers.} Each row is one signal on the 60-item anchor set: Pearson (with bootstrap 95\% CI) and Spearman against blind human soundness, the within-correct correlation (the margin a grader must win), the model-ranking Spearman on hard versus saturated benchmarks, and the share of per-solution variance owned by the item (the reference). Gold-token logprob uses the $n{=}42$ subset with logprob available; within-correct entries use $n{=}48$ ($n{=}32$ for logprob); the free bit is constant within the correct-only subset, so its within-correct entry is undefined by construction. Unigram-F1's hard-benchmark inversion ($-0.49$) is a verbosity confound, moving to $-0.07$ when output length is controlled. The judge row reports the Fisher interval because range restriction degenerates its bootstrap; the three post-hoc rows were added in response to review and carry no registration weight. The five-metric battery carries no multiplicity correction}{table.caption.14}{}}
