\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Takeaway: four of six registered predictions landed as called, with one sign flip and one falsification on record.} Each row is one pre-registered directional prediction, committed to the repository before its data were generated. The class-level divide, verification signals carrying signal where matching carries none, was called in advance, but the register did not anticipate that the free bit would top the class. The four stronger matching baselines of Section~\ref {sec:p1} were added post hoc in response to review and appear in no row of this ledger.}}{13}{table.caption.30}\protected@file@percent }
\newlabel{tab:ledger}{{5}{13}{\textbf {Takeaway: four of six registered predictions landed as called, with one sign flip and one falsification on record.} Each row is one pre-registered directional prediction, committed to the repository before its data were generated. The class-level divide, verification signals carrying signal where matching carries none, was called in advance, but the register did not anticipate that the free bit would top the class. The four stronger matching baselines of Section~\ref {sec:p1} were added post hoc in response to review and appear in no row of this ledger}{table.caption.30}{}}
