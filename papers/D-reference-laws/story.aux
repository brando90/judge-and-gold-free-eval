\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Takeaway: the step is the universal claim, positive with an interval excluding zero for every judge tested, while the trend beyond the step is null for the weaker judges. Multiplicity acts as a switch, not a dial.} Post-hoc paired re-analysis on the synthetic grid: per-item referenced-minus-blind inflation deltas at $k{=}1$, pooled over $k>1$, their difference, and the slope per $\log _2 k$; negative means the reference helps. The frozen estimator's pass-rate filter leaves $n{=}6$ items at $k{=}1$ and $n{=}20$ item-strata over $k>1$. The registered grid prediction had two legs: the inflation leg is confirmed in direction for all six judges, and the margin-growth leg is \emph  {falsified} for the weaker judges, whose margins sit flat at every $k>1$.}}{8}{table.caption.17}\protected@file@percent }
\newlabel{tab:paired}{{4}{8}{\textbf {Takeaway: the step is the universal claim, positive with an interval excluding zero for every judge tested, while the trend beyond the step is null for the weaker judges. Multiplicity acts as a switch, not a dial.} Post-hoc paired re-analysis on the synthetic grid: per-item referenced-minus-blind inflation deltas at $k{=}1$, pooled over $k>1$, their difference, and the slope per $\log _2 k$; negative means the reference helps. The frozen estimator's pass-rate filter leaves $n{=}6$ items at $k{=}1$ and $n{=}20$ item-strata over $k>1$. The registered grid prediction had two legs: the inflation leg is confirmed in direction for all six judges, and the margin-growth leg is \emph {falsified} for the weaker judges, whose margins sit flat at every $k>1$}{table.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Takeaway: the reference is at worst harmless at $k{=}1$, inverts as $k$ grows, and the any-correct-answer instruction rescues the strongest judge tested (phi-4, right) while leaving the mid-size judge (Qwen-7B, left) inflated.} Inflation (excess hack gap, in baseline standard deviations) versus the number of valid answers $k$, on the synthetic Qwen-generator pool, under four context conditions; whiskers are 95\% per-stratum bootstrap CIs. 12 tasks were built per stratum, but the frozen estimator's pass-rate filter leaves 4 to 6 items per plotted cell. Marker shapes and line styles distinguish conditions in addition to color.}}{8}{figure.caption.18}\protected@file@percent }
\newlabel{fig:synthk}{{3}{8}{\textbf {Takeaway: the reference is at worst harmless at $k{=}1$, inverts as $k$ grows, and the any-correct-answer instruction rescues the strongest judge tested (phi-4, right) while leaving the mid-size judge (Qwen-7B, left) inflated.} Inflation (excess hack gap, in baseline standard deviations) versus the number of valid answers $k$, on the synthetic Qwen-generator pool, under four context conditions; whiskers are 95\% per-stratum bootstrap CIs. 12 tasks were built per stratum, but the frozen estimator's pass-rate filter leaves 4 to 6 items per plotted cell. Marker shapes and line styles distinguish conditions in addition to color}{figure.caption.18}{}}
