\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Takeaway: rotating the shown reference to match a sample raises that identical sample's score by up to $+9.5$ of 10 points, with mirror-image losses for samples matching the displaced reference and a near-flat placebo. Anchoring is causal.} Bars are on the judge's 0--10 score scale at four judge sizes, averaged over two rubric paraphrases; whiskers span the union of the two paraphrases' 95\% bootstrap confidence intervals. \emph  {Navy}: the score gain of the identical, unchanged sample text when the reference is rotated to match its answer ($n{=}40$). \emph  {Blue}: the rotation-arm anchoring margin, the bonus valid reference-matching samples receive over equally valid non-matching ones ($n{=}18$). \emph  {Orange}: the same margin for blind judges on the same split, mostly null. \emph  {Light} bars: those two margins in the original-reference arm ($n{=}4$).}}{7}{figure.caption.10}\protected@file@percent }
\newlabel{fig:anchoring}{{2}{7}{\textbf {Takeaway: rotating the shown reference to match a sample raises that identical sample's score by up to $+9.5$ of 10 points, with mirror-image losses for samples matching the displaced reference and a near-flat placebo. Anchoring is causal.} Bars are on the judge's 0--10 score scale at four judge sizes, averaged over two rubric paraphrases; whiskers span the union of the two paraphrases' 95\% bootstrap confidence intervals. \emph {Navy}: the score gain of the identical, unchanged sample text when the reference is rotated to match its answer ($n{=}40$). \emph {Blue}: the rotation-arm anchoring margin, the bonus valid reference-matching samples receive over equally valid non-matching ones ($n{=}18$). \emph {Orange}: the same margin for blind judges on the same split, mostly null. \emph {Light} bars: those two margins in the original-reference arm ($n{=}4$)}{figure.caption.10}{}}
