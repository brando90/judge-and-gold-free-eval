\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Takeaway: the same trusted reference that collapses gaming on unique-answer tasks increases it when several answers are valid.} Inflation (scoreboard excess over true quality under best-of-$n$ selection, in baseline standard deviations over a permutation null) at $n{=}64$, for blind (orange) and referenced (blue) judges at four Qwen2.5 judge scales; arrows show the effect of adding the reference. Left: unique-answer math (companion A~\cite  {companionA}), where the reference collapses inflation $4$--$13\times $ at every scale. Right: \textsc  {RewardBench-2} Ties generation tasks with multiple valid answers ($n{=}51$), where the reference \emph  {raises} it at every scale; hollow markers are the registered in-band subset ($n{=}7$), which agrees in direction throughout.}}{5}{figure.caption.8}\protected@file@percent }
\newlabel{fig:inversion}{{1}{5}{\textbf {Takeaway: the same trusted reference that collapses gaming on unique-answer tasks increases it when several answers are valid.} Inflation (scoreboard excess over true quality under best-of-$n$ selection, in baseline standard deviations over a permutation null) at $n{=}64$, for blind (orange) and referenced (blue) judges at four Qwen2.5 judge scales; arrows show the effect of adding the reference. Left: unique-answer math (companion A~\cite {companionA}), where the reference collapses inflation $4$--$13\times $ at every scale. Right: \textsc {RewardBench-2} Ties generation tasks with multiple valid answers ($n{=}51$), where the reference \emph {raises} it at every scale; hollow markers are the registered in-band subset ($n{=}7$), which agrees in direction throughout}{figure.caption.8}{}}
