\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Anchoring margins among oracle-valid samples.} Mean score premium (0--10 scale) for valid samples matching the designated reference over equally valid non-matching samples, per judge scale, averaged over the two rubric paraphrases; whiskers span the union of the two paraphrases' 95\% bootstrap CIs, and blind cells use the same designated reference as a placebo split. Computed on the 4 items where both sample types occur under selection. \textbf  {Takeaway: referenced judges pay a large premium for matching the reference among answers that are all correct; blind judges do not.}}}{4}{figure.caption.8}\protected@file@percent }
\newlabel{fig:anchoring}{{2}{4}{\textbf {Anchoring margins among oracle-valid samples.} Mean score premium (0--10 scale) for valid samples matching the designated reference over equally valid non-matching samples, per judge scale, averaged over the two rubric paraphrases; whiskers span the union of the two paraphrases' 95\% bootstrap CIs, and blind cells use the same designated reference as a placebo split. Computed on the 4 items where both sample types occur under selection. \textbf {Takeaway: referenced judges pay a large premium for matching the reference among answers that are all correct; blind judges do not.}}{figure.caption.8}{}}
