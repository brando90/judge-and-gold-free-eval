\@writefile{toc}{\contentsline {subsection}{\numberline {3.7}The fix: score blind first, then reveal the reference}{14}{subsection.3.7}\protected@file@percent }
\newlabel{sec:struct}{{3.7}{14}{The fix: score blind first, then reveal the reference}{subsection.3.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces \textbf  {Takeaway: making the judge score blind before it sees the reference (M1) removes the measured inflation at $k{>}1$ for both judges and costs nothing at $k{=}1$, though it leaves roughly a third to three fifths of the anchoring premium at every $k$; the soft validity gate (M2) removes the inflation for phi-4 and makes matters worse than a plain reference for Qwen-7B.} Structural mitigations on the $k$-stratified pool, externally registered at \texttt  {osf.io/qugbd} before any data existed.}}{15}{table.caption.27}\protected@file@percent }
\newlabel{tab:struct}{{10}{15}{\textbf {Takeaway: making the judge score blind before it sees the reference (M1) removes the measured inflation at $k{>}1$ for both judges and costs nothing at $k{=}1$, though it leaves roughly a third to three fifths of the anchoring premium at every $k$; the soft validity gate (M2) removes the inflation for phi-4 and makes matters worse than a plain reference for Qwen-7B.} Structural mitigations on the $k$-stratified pool, externally registered at \texttt {osf.io/qugbd} before any data existed}{table.caption.27}{}}
\@writefile{toc}{\contentsline {paragraph}{The boundary itself, preregistered with exact $k$ control (P-M3): confirmed.}{16}{section*.28}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Blind-then-reveal removes the measured inflation and costs nothing at $k{=}1$ (P-M1): partially confirmed.}{16}{section*.29}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The soft validity gate splits by judge, opposite to the instruction (P-M2): partially confirmed.}{16}{section*.30}\protected@file@percent }
