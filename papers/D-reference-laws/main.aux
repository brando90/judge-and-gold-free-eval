\@writefile{toc}{\contentsline {paragraph}{The step is the universal claim (P-S1).}{11}{section*.22}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {Takeaway: the reference is harmless at $k{=}1$ and inflates at high $k$ (bold cells); the any-correct-answer instruction closes phi-4's inflation but not Qwen-7B's; multiple references reduce Qwen-7B's $k{=}16$ inflation without matching blind; and on the cross-family Llama pool the inversion replicates while the $k{=}1$ help does not.} Inflation in baseline standard deviations, per multiplicity stratum on the synthetic grid, two rubric replicates per cell. 12 tasks were built per stratum, but the frozen estimator drops items whose pool pass rate falls outside $[0.05, 0.95]$, since a degenerate pool carries no selection signal, so 4 to 6 items enter each cell on the Qwen pool.}}{12}{table.caption.18}\protected@file@percent }
\newlabel{tab:synthk}{{7}{12}{\textbf {Takeaway: the reference is harmless at $k{=}1$ and inflates at high $k$ (bold cells); the any-correct-answer instruction closes phi-4's inflation but not Qwen-7B's; multiple references reduce Qwen-7B's $k{=}16$ inflation without matching blind; and on the cross-family Llama pool the inversion replicates while the $k{=}1$ help does not.} Inflation in baseline standard deviations, per multiplicity stratum on the synthetic grid, two rubric replicates per cell. 12 tasks were built per stratum, but the frozen estimator drops items whose pool pass rate falls outside $[0.05, 0.95]$, since a degenerate pool carries no selection signal, so 4 to 6 items enter each cell on the Qwen pool}{table.caption.18}{}}
\@writefile{toc}{\contentsline {paragraph}{Anchoring saturates early for weaker judges, falsifying half of P-S1.}{12}{section*.23}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Telling the judge to accept any valid answer works only above a capability gate (P-S2, P-S2b).}{12}{section*.24}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {Takeaway: the step is the universal claim, positive with a CI excluding zero for every judge tested; the reference helps at $k{=}1$ for five of six judges on this single pool; the $k{>}1$ inflation level is individually significant for three of six; and the trend beyond the step is null for the weaker judges and positive for the strongest.} Post-hoc paired re-analysis on the synthetic grid (Table~\ref {tab:ledger}): per-item paired referenced-minus-blind inflation deltas at $k{=}1$, pooled over $k > 1$, their difference (the step), and the slope of the per-item delta per $\log _2 k$. Negative means the reference helps, positive means it inflates. 12 tasks were built per stratum, but the in-band pass-rate filter $[0.05, 0.95]$ drops items, so the analysis runs on $n{=}6$ items at $k{=}1$ and $n{=}20$ item-strata pooled over $k > 1$. The 14B trend's lower limit sits at zero.}}{13}{table.caption.20}\protected@file@percent }
\newlabel{tab:paired}{{8}{13}{\textbf {Takeaway: the step is the universal claim, positive with a CI excluding zero for every judge tested; the reference helps at $k{=}1$ for five of six judges on this single pool; the $k{>}1$ inflation level is individually significant for three of six; and the trend beyond the step is null for the weaker judges and positive for the strongest.} Post-hoc paired re-analysis on the synthetic grid (Table~\ref {tab:ledger}): per-item paired referenced-minus-blind inflation deltas at $k{=}1$, pooled over $k > 1$, their difference (the step), and the slope of the per-item delta per $\log _2 k$. Negative means the reference helps, positive means it inflates. 12 tasks were built per stratum, but the in-band pass-rate filter $[0.05, 0.95]$ drops items, so the analysis runs on $n{=}6$ items at $k{=}1$ and $n{=}20$ item-strata pooled over $k > 1$. The 14B trend's lower limit sits at zero}{table.caption.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces \textbf  {Takeaway: the any-correct-answer instruction reduces anchoring in proportion to judge capability, completely for phi-4, partially for 14B, and not at all, or worse, at the bottom of the ladder, with the same gate ordering under a second, do-not-compare phrasing.} Anchoring margins on the 0--10 score scale at $k{=}16$ on the synthetic Qwen pool, single reference versus reference plus instruction; larger means more anchoring. 12 tasks were built in that stratum, but a margin is defined only on items where reference-matching and non-matching valid answers coexist, which leaves $n{=}5$ items per margin cell. The second-phrasing arm is P-S2b, registered before the run, and covers rubric-$a$ margins at $k{>}1$ only, with no rubric-$b$ replicate and no inflation readout, so it tests the registered gate-ordering claim and nothing beyond it. The 1.5B worsening is rubric-specific: rubric $a$ worsens under both phrasings while rubric $b$ improves.}}{13}{table.caption.21}\protected@file@percent }
\newlabel{tab:mitig}{{9}{13}{\textbf {Takeaway: the any-correct-answer instruction reduces anchoring in proportion to judge capability, completely for phi-4, partially for 14B, and not at all, or worse, at the bottom of the ladder, with the same gate ordering under a second, do-not-compare phrasing.} Anchoring margins on the 0--10 score scale at $k{=}16$ on the synthetic Qwen pool, single reference versus reference plus instruction; larger means more anchoring. 12 tasks were built in that stratum, but a margin is defined only on items where reference-matching and non-matching valid answers coexist, which leaves $n{=}5$ items per margin cell. The second-phrasing arm is P-S2b, registered before the run, and covers rubric-$a$ margins at $k{>}1$ only, with no rubric-$b$ replicate and no inflation readout, so it tests the registered gate-ordering claim and nothing beyond it. The 1.5B worsening is rubric-specific: rubric $a$ worsens under both phrasings while rubric $b$ improves}{table.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Takeaway: the reference is at worst harmless at $k{=}1$, inverts as $k$ grows, and the any-correct-answer instruction rescues the strongest judge tested (phi-4, right) while leaving the mid-size judge (Qwen-7B, left) inflated.} Inflation (excess hack gap, in baseline standard deviations) versus the number of valid answers $k$, on the synthetic Qwen-generator pool, under four context conditions; whiskers are 95\% per-stratum bootstrap CIs. 12 tasks were built per stratum, but the frozen estimator drops items whose pool pass rate falls outside $[0.05, 0.95]$, so 4 to 6 items enter each plotted cell. Marker shapes and line styles distinguish conditions in addition to color.}}{14}{figure.caption.19}\protected@file@percent }
\newlabel{fig:synthk}{{2}{14}{\textbf {Takeaway: the reference is at worst harmless at $k{=}1$, inverts as $k$ grows, and the any-correct-answer instruction rescues the strongest judge tested (phi-4, right) while leaving the mid-size judge (Qwen-7B, left) inflated.} Inflation (excess hack gap, in baseline standard deviations) versus the number of valid answers $k$, on the synthetic Qwen-generator pool, under four context conditions; whiskers are 95\% per-stratum bootstrap CIs. 12 tasks were built per stratum, but the frozen estimator drops items whose pool pass rate falls outside $[0.05, 0.95]$, so 4 to 6 items enter each plotted cell. Marker shapes and line styles distinguish conditions in addition to color}{figure.caption.19}{}}
