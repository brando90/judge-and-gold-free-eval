\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Takeaway: the reference helps at $k{=}1$ and inflates at high $k$ (bold cells); the any-correct-answer instruction closes phi-4's inflation but not Qwen-7B's; multiple references reduce Qwen-7B's $k{=}16$ inflation without matching blind; and on the cross-family Llama pool the inversion replicates while the $k{=}1$ help does not.} Inflation (baseline SD) per multiplicity stratum on the synthetic grid.}}{9}{table.caption.10}\protected@file@percent }
\newlabel{tab:synthk}{{3}{9}{\textbf {Takeaway: the reference helps at $k{=}1$ and inflates at high $k$ (bold cells); the any-correct-answer instruction closes phi-4's inflation but not Qwen-7B's; multiple references reduce Qwen-7B's $k{=}16$ inflation without matching blind; and on the cross-family Llama pool the inversion replicates while the $k{=}1$ help does not.} Inflation (baseline SD) per multiplicity stratum on the synthetic grid}{table.caption.10}{}}
\@writefile{toc}{\contentsline {paragraph}{Multiplicity is a switch, and the step is the universal claim (P-S1).}{9}{section*.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Takeaway: the reference helps at $k{=}1$, inverts as $k$ grows, and the any-correct-answer instruction rescues the strongest judge tested (phi-4, right) while leaving the mid-size judge (Qwen-7B, left) inflated.} Excess hack gap versus number of valid answers $k$ on the synthetic Qwen-generator pool, under four context conditions; whiskers are 95\% per-stratum bootstrap CIs. Marker shapes and line styles distinguish conditions in addition to color.}}{10}{figure.caption.11}\protected@file@percent }
\newlabel{fig:synthk}{{2}{10}{\textbf {Takeaway: the reference helps at $k{=}1$, inverts as $k$ grows, and the any-correct-answer instruction rescues the strongest judge tested (phi-4, right) while leaving the mid-size judge (Qwen-7B, left) inflated.} Excess hack gap versus number of valid answers $k$ on the synthetic Qwen-generator pool, under four context conditions; whiskers are 95\% per-stratum bootstrap CIs. Marker shapes and line styles distinguish conditions in addition to color}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {paragraph}{The margin does not grow with $k$ for weaker judges, falsifying half of P-S1.}{10}{section*.15}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The any-correct-answer instruction is capability-graded (P-S2, P-S2b).}{10}{section*.16}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Takeaway: the step is the universal claim, positive with a CI excluding zero for every judge tested; the reference helps at $k{=}1$ for five of six; the $k{>}1$ inflation level is individually significant for three of six; and the trend beyond the step is null for the weaker judges and positive for the strongest.} Post-hoc paired re-analysis on the synthetic grid (Table~\ref {tab:ledger}): per-item paired referenced-minus-blind inflation deltas at $k{=}1$, pooled over $k > 1$, their difference (the step), and the slope of the per-item delta per $\log _2 k$; the 14B trend's lower limit sits at zero.}}{11}{table.caption.12}\protected@file@percent }
\newlabel{tab:paired}{{4}{11}{\textbf {Takeaway: the step is the universal claim, positive with a CI excluding zero for every judge tested; the reference helps at $k{=}1$ for five of six; the $k{>}1$ inflation level is individually significant for three of six; and the trend beyond the step is null for the weaker judges and positive for the strongest.} Post-hoc paired re-analysis on the synthetic grid (Table~\ref {tab:ledger}): per-item paired referenced-minus-blind inflation deltas at $k{=}1$, pooled over $k > 1$, their difference (the step), and the slope of the per-item delta per $\log _2 k$; the 14B trend's lower limit sits at zero}{table.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Takeaway: the any-correct-answer instruction reduces anchoring in proportion to judge capability, completely for phi-4, partially for 14B, and not at all, or worse, at the bottom of the ladder, with the same gate ordering under a second, do-not-compare phrasing.} Anchoring margins (0--10 scale) at $k{=}16$ on the synthetic Qwen pool, single reference versus reference-plus-instruction; the second-phrasing arm is P-S2b, registered before the run, and covers rubric-$a$ margins at $k{>}1$ only (no rubric-$b$ replicate, no inflation readout), so it tests the registered gate-ordering claim and nothing beyond it. The 1.5B worsening is rubric-specific: rubric $a$ worsens under both phrasings while rubric $b$ improves.}}{11}{table.caption.13}\protected@file@percent }
\newlabel{tab:mitig}{{5}{11}{\textbf {Takeaway: the any-correct-answer instruction reduces anchoring in proportion to judge capability, completely for phi-4, partially for 14B, and not at all, or worse, at the bottom of the ladder, with the same gate ordering under a second, do-not-compare phrasing.} Anchoring margins (0--10 scale) at $k{=}16$ on the synthetic Qwen pool, single reference versus reference-plus-instruction; the second-phrasing arm is P-S2b, registered before the run, and covers rubric-$a$ margins at $k{>}1$ only (no rubric-$b$ replicate, no inflation readout), so it tests the registered gate-ordering claim and nothing beyond it. The 1.5B worsening is rubric-specific: rubric $a$ worsens under both phrasings while rubric $b$ improves}{table.caption.13}{}}
