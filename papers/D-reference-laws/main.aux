\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Best-of-64 on 51 multi-valid Ties tasks (full-pool analysis; post-hoc deviation from the registered in-band filter, adopted for power).} Excess hack gap (baseline SD over the within-oracle-stratum permutation null) and oracle regret per judge scale and condition, with paired item-level ref-minus-noref gap deltas and bootstrap CIs. The reference worsens both readouts directionally on every row; per-scale gap deltas do not individually reach significance at $n{=}51$, the pooled gap delta does, and the regret deltas ($+0.020$ per scale, pooled $+0.020$ $[-0.025, +0.069]$) all cross zero. \textbf  {Takeaway: adding the reference never helps, directionally hurts on every row, and the pooled gap inflation excludes zero.}}}{4}{table.caption.7}\protected@file@percent }
\newlabel{tab:fullset}{{1}{4}{\textbf {Best-of-64 on 51 multi-valid Ties tasks (full-pool analysis; post-hoc deviation from the registered in-band filter, adopted for power).} Excess hack gap (baseline SD over the within-oracle-stratum permutation null) and oracle regret per judge scale and condition, with paired item-level ref-minus-noref gap deltas and bootstrap CIs. The reference worsens both readouts directionally on every row; per-scale gap deltas do not individually reach significance at $n{=}51$, the pooled gap delta does, and the regret deltas ($+0.020$ per scale, pooled $+0.020$ $[-0.025, +0.069]$) all cross zero. \textbf {Takeaway: adding the reference never helps, directionally hurts on every row, and the pooled gap inflation excludes zero.}}{table.caption.7}{}}
