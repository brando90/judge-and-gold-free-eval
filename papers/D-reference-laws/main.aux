\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Takeaway: the anchoring premium follows whichever valid answer is shown as the reference, moving with the reference even for identical sample text; blind judges pay no premium.} Anchoring effects (0--10 score scale) per judge scale, averaged over the two rubric paraphrases; whiskers span the union of the two paraphrases' 95\% bootstrap CIs. Navy: paired same-sample deltas, the score gain of the identical sample when the reference is rotated to match it ($n{=}40$ items per cell). Blue: cross-sectional margin of valid matching over valid non-matching samples in the rotation arm ($n{=}18$). Light blue: the same margin in the original-reference arm ($n{=}4$). Orange: blind judges scored on the same split as a placebo ($n{=}4$).}}{5}{figure.caption.8}\protected@file@percent }
\newlabel{fig:anchoring}{{2}{5}{\textbf {Takeaway: the anchoring premium follows whichever valid answer is shown as the reference, moving with the reference even for identical sample text; blind judges pay no premium.} Anchoring effects (0--10 score scale) per judge scale, averaged over the two rubric paraphrases; whiskers span the union of the two paraphrases' 95\% bootstrap CIs. Navy: paired same-sample deltas, the score gain of the identical sample when the reference is rotated to match it ($n{=}40$ items per cell). Blue: cross-sectional margin of valid matching over valid non-matching samples in the rotation arm ($n{=}18$). Light blue: the same margin in the original-reference arm ($n{=}4$). Orange: blind judges scored on the same split as a placebo ($n{=}4$)}{figure.caption.8}{}}
