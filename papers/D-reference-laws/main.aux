\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {Takeaway: on multi-valid tasks, adding the reference never helps, directionally hurts on every row, and the pooled inflation delta excludes zero, while the identical math protocol shows the reference collapsing inflation $4$--$13\times $.}}}{16}{table.caption.27}\protected@file@percent }
\newlabel{tab:fullset}{{7}{16}{\textbf {Takeaway: on multi-valid tasks, adding the reference never helps, directionally hurts on every row, and the pooled inflation delta excludes zero, while the identical math protocol shows the reference collapsing inflation $4$--$13\times $.}}{table.caption.27}{}}
