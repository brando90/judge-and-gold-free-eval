\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Best-of-64 on 51 multi-valid Ties tasks.} Excess hack gap (baseline SD over the within-oracle-stratum permutation null) and oracle regret per judge scale and condition, with paired item-level ref-minus-noref gap deltas and bootstrap CIs. The reference raises the gap at 4 of 4 scales and raises regret at 4 of 4 scales; individual deltas do not reach significance at $n{=}51$. \textbf  {Takeaway: adding the reference never helps and directionally hurts on every row.}}}{3}{table.caption.7}\protected@file@percent }
\newlabel{tab:fullset}{{1}{3}{\textbf {Best-of-64 on 51 multi-valid Ties tasks.} Excess hack gap (baseline SD over the within-oracle-stratum permutation null) and oracle regret per judge scale and condition, with paired item-level ref-minus-noref gap deltas and bootstrap CIs. The reference raises the gap at 4 of 4 scales and raises regret at 4 of 4 scales; individual deltas do not reach significance at $n{=}51$. \textbf {Takeaway: adding the reference never helps and directionally hurts on every row.}}{table.caption.7}{}}
