\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The inversion.} Excess hack gap (scoreboard inflation under best-of-$n$ selection, in baseline standard deviations over a permutation null) at $n{=}64$ for blind (orange) and referenced (blue) judges at four Qwen2.5 judge scales; arrows show the effect of adding the reference. Left: unique-answer math (companion A~\cite  {companionA}), where the reference collapses the gap $4$--$13\times $ at every scale. Right: \textsc  {RewardBench-2} Ties generation tasks with multiple valid answers ($n{=}51$ items), where the reference \emph  {raises} the gap at every scale; small hollow markers show the registered in-band subset ($n{=}7$ items), which agrees in direction at every scale. \textbf  {Takeaway: the same trusted reference that collapses gaming on unique-answer tasks increases it when several answers are valid.}}}{15}{figure.caption.26}\protected@file@percent }
\newlabel{fig:inversion}{{3}{15}{\textbf {The inversion.} Excess hack gap (scoreboard inflation under best-of-$n$ selection, in baseline standard deviations over a permutation null) at $n{=}64$ for blind (orange) and referenced (blue) judges at four Qwen2.5 judge scales; arrows show the effect of adding the reference. Left: unique-answer math (companion A~\cite {companionA}), where the reference collapses the gap $4$--$13\times $ at every scale. Right: \textsc {RewardBench-2} Ties generation tasks with multiple valid answers ($n{=}51$ items), where the reference \emph {raises} the gap at every scale; small hollow markers show the registered in-band subset ($n{=}7$ items), which agrees in direction at every scale. \textbf {Takeaway: the same trusted reference that collapses gaming on unique-answer tasks increases it when several answers are valid.}}{figure.caption.26}{}}
