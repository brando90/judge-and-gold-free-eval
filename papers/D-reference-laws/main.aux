\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {Takeaway: making the judge score blind before it sees the reference (M1) removes the measured harm at $k{>}1$ for both judges while preserving the $k{=}1$ benefit, and decomposing validity into a separate call (M2) removes it entirely for the stronger judge and backfires for the weaker one.} Structural mitigations on the $k$-stratified pool, externally registered at \texttt  {osf.io/qugbd} before any data existed.}}{13}{table.caption.20}\protected@file@percent }
\newlabel{tab:struct}{{6}{13}{\textbf {Takeaway: making the judge score blind before it sees the reference (M1) removes the measured harm at $k{>}1$ for both judges while preserving the $k{=}1$ benefit, and decomposing validity into a separate call (M2) removes it entirely for the stronger judge and backfires for the weaker one.} Structural mitigations on the $k$-stratified pool, externally registered at \texttt {osf.io/qugbd} before any data existed}{table.caption.20}{}}
