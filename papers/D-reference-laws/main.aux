\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:headline}{{1}{2}{\textbf {Takeaway: the whole paper in four numbers.} Inflation is in baseline standard deviations of the judge's own score distribution; anchoring is in points of the judge's 0--10 scale. Scope: short-answer tasks with exact programmatic validity oracles. Details, caveats and the conservative readings are in the sections named}{table.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Takeaway: rotating the shown reference to match a sample raises that identical sample's score by up to $+9.5$ of 10 points, with mirror-image losses for samples matching the displaced reference and a near-flat placebo. Anchoring is causal.} Bars are on the judge's 0--10 score scale at four judge sizes, averaged over two rubric paraphrases; whiskers span the union of the two paraphrases' 95\% bootstrap confidence intervals. \emph  {Navy}: the score gain of the identical, unchanged sample text when the reference is rotated to match its answer ($n{=}40$ items per cell). \emph  {Blue}: the anchoring margin in the rotation arm, the score bonus valid reference-matching samples receive over equally valid non-matching ones ($n{=}18$). \emph  {Orange}: the same margin for blind judges, who see no reference, on the same split; mostly null ($n{=}18$). \emph  {Light blue} and \emph  {light orange}: those same two margins in the original-reference arm ($n{=}4$). The two controls named in the takeaway, the near-flat placebo (samples matching neither reference) and the mirror-image losses (samples matching only the displaced reference), are quantified in Section~\ref {sec:mech} and Table~\ref {tab:rot}.}}{2}{figure.caption.2}\protected@file@percent }
\newlabel{fig:anchoring}{{1}{2}{\textbf {Takeaway: rotating the shown reference to match a sample raises that identical sample's score by up to $+9.5$ of 10 points, with mirror-image losses for samples matching the displaced reference and a near-flat placebo. Anchoring is causal.} Bars are on the judge's 0--10 score scale at four judge sizes, averaged over two rubric paraphrases; whiskers span the union of the two paraphrases' 95\% bootstrap confidence intervals. \emph {Navy}: the score gain of the identical, unchanged sample text when the reference is rotated to match its answer ($n{=}40$ items per cell). \emph {Blue}: the anchoring margin in the rotation arm, the score bonus valid reference-matching samples receive over equally valid non-matching ones ($n{=}18$). \emph {Orange}: the same margin for blind judges, who see no reference, on the same split; mostly null ($n{=}18$). \emph {Light blue} and \emph {light orange}: those same two margins in the original-reference arm ($n{=}4$). The two controls named in the takeaway, the near-flat placebo (samples matching neither reference) and the mirror-image losses (samples matching only the displaced reference), are quantified in Section~\ref {sec:mech} and Table~\ref {tab:rot}}{figure.caption.2}{}}
