\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {Takeaway: on multi-valid tasks, adding the reference never helps, directionally hurts on every row, and the pooled inflation delta excludes zero, while the identical math protocol shows the reference collapsing inflation $4$--$13\times $.} Exploratory Ties study, best-of-64 selection at four Qwen2.5 judge scales, in three panels: the post-hoc full pool ($n{=}51$ items), the registered in-band subset ($n{=}7$), and the unique-answer math contrast. Higher is worse in every column.}}{15}{table.caption.26}\protected@file@percent }
\newlabel{tab:fullset}{{7}{15}{\textbf {Takeaway: on multi-valid tasks, adding the reference never helps, directionally hurts on every row, and the pooled inflation delta excludes zero, while the identical math protocol shows the reference collapsing inflation $4$--$13\times $.} Exploratory Ties study, best-of-64 selection at four Qwen2.5 judge scales, in three panels: the post-hoc full pool ($n{=}51$ items), the registered in-band subset ($n{=}7$), and the unique-answer math contrast. Higher is worse in every column}{table.caption.26}{}}
