\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Takeaway: the registered prediction was falsified in reverse. Inflation does not grow with the opportunity to select a reference-matching correct answer; it is largest when no valid answer matches the reference at all, because reference similarity then pulls selection onto incorrect look-alikes.}}}{9}{table.caption.12}\protected@file@percent }
\newlabel{tab:dose}{{5}{9}{\textbf {Takeaway: the registered prediction was falsified in reverse. Inflation does not grow with the opportunity to select a reference-matching correct answer; it is largest when no valid answer matches the reference at all, because reference similarity then pulls selection onto incorrect look-alikes.}}{table.caption.12}{}}
