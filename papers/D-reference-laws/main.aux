\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Takeaway: on multi-valid tasks, adding the reference never helps, directionally hurts on every row, and the pooled inflation delta excludes zero, while the identical math protocol shows the reference collapsing inflation $4$--$13\times $.}}}{17}{table.caption.10}\protected@file@percent }
\newlabel{tab:fullset}{{2}{17}{\textbf {Takeaway: on multi-valid tasks, adding the reference never helps, directionally hurts on every row, and the pooled inflation delta excludes zero, while the identical math protocol shows the reference collapsing inflation $4$--$13\times $.}}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Takeaway: the identical sample text gains up to $+9.5$ of 10 points when the rotated reference matches it, samples matching the displaced reference lose a roughly symmetric amount, blind margins on the same split are mostly null, and whenever a matching answer is on offer the referenced judge selects it nearly always.}}}{18}{table.caption.11}\protected@file@percent }
\newlabel{tab:rot}{{3}{18}{\textbf {Takeaway: the identical sample text gains up to $+9.5$ of 10 points when the rotated reference matches it, samples matching the displaced reference lose a roughly symmetric amount, blind margins on the same split are mostly null, and whenever a matching answer is on offer the referenced judge selects it nearly always.}}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Takeaway: the reference helps at $k{=}1$ and inflates at high $k$ (bold cells); the any-correct-answer instruction closes phi-4's inflation but not Qwen-7B's; multiple references reduce Qwen-7B's $k{=}16$ inflation without matching blind; and on the cross-family Llama pool the inversion replicates while the $k{=}1$ help does not.} Inflation (baseline SD) per multiplicity stratum on the synthetic grid.}}{19}{table.caption.12}\protected@file@percent }
\newlabel{tab:synthk}{{4}{19}{\textbf {Takeaway: the reference helps at $k{=}1$ and inflates at high $k$ (bold cells); the any-correct-answer instruction closes phi-4's inflation but not Qwen-7B's; multiple references reduce Qwen-7B's $k{=}16$ inflation without matching blind; and on the cross-family Llama pool the inversion replicates while the $k{=}1$ help does not.} Inflation (baseline SD) per multiplicity stratum on the synthetic grid}{table.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Takeaway: the step is the universal claim, positive with a CI excluding zero for every judge tested; the reference helps at $k{=}1$ for five of six; the $k{>}1$ inflation level is individually significant for three of six; and the trend beyond the step is null for the weaker judges and positive for the strongest.} Post-hoc paired re-analysis on the synthetic grid (Table~\ref {tab:ledger}): per-item paired referenced-minus-blind inflation deltas at $k{=}1$, pooled over $k > 1$, their difference (the step), and the slope of the per-item delta per $\log _2 k$; the 14B trend's lower limit sits at zero.}}{19}{table.caption.14}\protected@file@percent }
\newlabel{tab:paired}{{5}{19}{\textbf {Takeaway: the step is the universal claim, positive with a CI excluding zero for every judge tested; the reference helps at $k{=}1$ for five of six; the $k{>}1$ inflation level is individually significant for three of six; and the trend beyond the step is null for the weaker judges and positive for the strongest.} Post-hoc paired re-analysis on the synthetic grid (Table~\ref {tab:ledger}): per-item paired referenced-minus-blind inflation deltas at $k{=}1$, pooled over $k > 1$, their difference (the step), and the slope of the per-item delta per $\log _2 k$; the 14B trend's lower limit sits at zero}{table.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {Takeaway: the any-correct-answer instruction reduces anchoring in proportion to judge capability, completely for phi-4, partially for 14B, and not at all, or worse, at the bottom of the ladder, with the same gate ordering under a second, do-not-compare phrasing.} Anchoring margins (0--10 scale) at $k{=}16$ on the synthetic Qwen pool, single reference versus reference-plus-instruction; the second-phrasing arm is P-S2b, registered before the run, and covers rubric-$a$ margins at $k{>}1$ only (no rubric-$b$ replicate, no inflation readout), so it tests the registered gate-ordering claim and nothing beyond it. The 1.5B worsening is rubric-specific: rubric $a$ worsens under both phrasings while rubric $b$ improves.}}{20}{table.caption.15}\protected@file@percent }
\newlabel{tab:mitig}{{6}{20}{\textbf {Takeaway: the any-correct-answer instruction reduces anchoring in proportion to judge capability, completely for phi-4, partially for 14B, and not at all, or worse, at the bottom of the ladder, with the same gate ordering under a second, do-not-compare phrasing.} Anchoring margins (0--10 scale) at $k{=}16$ on the synthetic Qwen pool, single reference versus reference-plus-instruction; the second-phrasing arm is P-S2b, registered before the run, and covers rubric-$a$ margins at $k{>}1$ only (no rubric-$b$ replicate, no inflation readout), so it tests the registered gate-ordering claim and nothing beyond it. The 1.5B worsening is rubric-specific: rubric $a$ worsens under both phrasings while rubric $b$ improves}{table.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {Takeaway: the preregistered replication confirms all three registered predictions, with a pooled inflation delta roughly three times the original Ties-pool estimate and both judges individually significant.} Externally registered at \texttt  {osf.io/ym5x9} before any pool generation.}}{20}{table.caption.22}\protected@file@percent }
\newlabel{tab:repl}{{7}{20}{\textbf {Takeaway: the preregistered replication confirms all three registered predictions, with a pooled inflation delta roughly three times the original Ties-pool estimate and both judges individually significant.} Externally registered at \texttt {osf.io/ym5x9} before any pool generation}{table.caption.22}{}}
