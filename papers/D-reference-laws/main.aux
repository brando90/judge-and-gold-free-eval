\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {Takeaway: on multi-valid tasks, adding the reference never helps, directionally hurts on every row, and the pooled inflation delta excludes zero, while the identical math protocol shows the reference collapsing inflation $4$--$13\times $.} Exploratory Ties study, best-of-64 selection at four Qwen2.5 judge scales, in three panels: the post-hoc full pool ($n{=}51$ items), the registered in-band subset ($n{=}7$), and the unique-answer math contrast. Higher is worse in every column.}}{17}{table.caption.28}\protected@file@percent }
\newlabel{tab:fullset}{{8}{17}{\textbf {Takeaway: on multi-valid tasks, adding the reference never helps, directionally hurts on every row, and the pooled inflation delta excludes zero, while the identical math protocol shows the reference collapsing inflation $4$--$13\times $.} Exploratory Ties study, best-of-64 selection at four Qwen2.5 judge scales, in three panels: the post-hoc full pool ($n{=}51$ items), the registered in-band subset ($n{=}7$), and the unique-answer math contrast. Higher is worse in every column}{table.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Takeaway: the same trusted reference that collapses gaming on unique-answer tasks increases it when several answers are valid. This is the inversion.} Inflation (scoreboard excess over true quality under best-of-$n$ selection, in baseline standard deviations over a permutation null) at $n{=}64$, for blind (orange) and referenced (blue) judges at four Qwen2.5 judge scales; arrows show the effect of adding the reference. Left: unique-answer math (companion A~\cite  {companionA}), where the reference collapses inflation $4$--$13\times $ at every scale. Right: \textsc  {RewardBench-2} Ties generation tasks with multiple valid answers ($n{=}51$ items), where the reference \emph  {raises} it at every scale. Small hollow markers show the registered in-band subset ($n{=}7$ items), which agrees in direction at every scale.}}{18}{figure.caption.27}\protected@file@percent }
\newlabel{fig:inversion}{{3}{18}{\textbf {Takeaway: the same trusted reference that collapses gaming on unique-answer tasks increases it when several answers are valid. This is the inversion.} Inflation (scoreboard excess over true quality under best-of-$n$ selection, in baseline standard deviations over a permutation null) at $n{=}64$, for blind (orange) and referenced (blue) judges at four Qwen2.5 judge scales; arrows show the effect of adding the reference. Left: unique-answer math (companion A~\cite {companionA}), where the reference collapses inflation $4$--$13\times $ at every scale. Right: \textsc {RewardBench-2} Ties generation tasks with multiple valid answers ($n{=}51$ items), where the reference \emph {raises} it at every scale. Small hollow markers show the registered in-band subset ($n{=}7$ items), which agrees in direction at every scale}{figure.caption.27}{}}
