\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Takeaway: the reference collapses inflation at every scale on math, where using it means comparing text, and only at 3B and above on code, where using it means executing tests.} Inflation at $n{=}64$ without (orange) and with (blue) a trusted reference, by judge scale and domain.}}{9}{figure.caption.18}\protected@file@percent }
\newlabel{fig:gate}{{4}{9}{\textbf {Takeaway: the reference collapses inflation at every scale on math, where using it means comparing text, and only at 3B and above on code, where using it means executing tests.} Inflation at $n{=}64$ without (orange) and with (blue) a trusted reference, by judge scale and domain}{figure.caption.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Takeaway: training against the certified judge raises true accuracy on the training items while training against the convicted judge degrades held-out accuracy --- the verdicts predicted which judge was safe to optimize against --- and the registered wedge prediction is falsified in direction, the corruption expressing itself as damage rather than gaming at this scale.} Externally registered DPO rerun (\texttt  {osf.io/jg4ak}); identical LoRA-DPO arms differing only in which frozen judge built the preference pairs. Score gains are instrument-specific in the registered direction: the certified arm's gain is largest under its own judge ($+1.01$ versus $+0.31$ under the sabotaged judge, on train), and the convicted arm's loss is also largest under its own judge ($-1.40$ versus $-0.91$).}}{9}{table.caption.20}\protected@file@percent }
\newlabel{tab:dpo}{{2}{9}{\textbf {Takeaway: training against the certified judge raises true accuracy on the training items while training against the convicted judge degrades held-out accuracy --- the verdicts predicted which judge was safe to optimize against --- and the registered wedge prediction is falsified in direction, the corruption expressing itself as damage rather than gaming at this scale.} Externally registered DPO rerun (\texttt {osf.io/jg4ak}); identical LoRA-DPO arms differing only in which frozen judge built the preference pairs. Score gains are instrument-specific in the registered direction: the certified arm's gain is largest under its own judge ($+1.01$ versus $+0.31$ under the sabotaged judge, on train), and the convicted arm's loss is also largest under its own judge ($-1.40$ versus $-0.91$)}{table.caption.20}{}}
\@writefile{toc}{\contentsline {paragraph}{The result.}{9}{section*.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Takeaway: convictions are cheap and stable; verdicts near the pass boundary are the ones that need more labels --- and the one verdict that never stabilized below the full label set is the one that proved false.} Verdict stability under label subsampling: fraction of 500 resamples per point reproducing the full-sample verdict under the fixed rules.}}{10}{figure.caption.23}\protected@file@percent }
\newlabel{fig:stability}{{5}{10}{\textbf {Takeaway: convictions are cheap and stable; verdicts near the pass boundary are the ones that need more labels --- and the one verdict that never stabilized below the full label set is the one that proved false.} Verdict stability under label subsampling: fraction of 500 resamples per point reproducing the full-sample verdict under the fixed rules}{figure.caption.23}{}}
