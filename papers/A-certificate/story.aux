\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Takeaway: within each domain, certified configurations stay low and flat relative to failed ones, but pressure growth is heterogeneous --- the certificate predicts relative position within a domain, not a universal slope.} Raw hack gap versus best-of-$n$ for every configuration with existing candidate pools, recomputed at $n = 4, 16, 64$ with the pre-registered estimators. Blue: certified (referenced) configurations; orange: failed or convicted ones. Some certified curves do rise (the referenced frontier on math moves $+0.50 \to +0.71$; the referenced 14B on code $+0.30 \to +0.49$), the referenced 1.5B on code climbs to failed-cluster levels ($+0.35 \to +1.46$, the capability-gate miss), and the sabotaged 7B on math declines ($+0.22 \to +0.14$).}}{8}{figure.caption.14}\protected@file@percent }
\newlabel{fig:curves}{{3}{8}{\textbf {Takeaway: within each domain, certified configurations stay low and flat relative to failed ones, but pressure growth is heterogeneous --- the certificate predicts relative position within a domain, not a universal slope.} Raw hack gap versus best-of-$n$ for every configuration with existing candidate pools, recomputed at $n = 4, 16, 64$ with the pre-registered estimators. Blue: certified (referenced) configurations; orange: failed or convicted ones. Some certified curves do rise (the referenced frontier on math moves $+0.50 \to +0.71$; the referenced 14B on code $+0.30 \to +0.49$), the referenced 1.5B on code climbs to failed-cluster levels ($+0.35 \to +1.46$, the capability-gate miss), and the sabotaged 7B on math declines ($+0.22 \to +0.14$)}{figure.caption.14}{}}
