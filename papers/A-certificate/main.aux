\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Naive validation versus the audit, against pressure outcomes (math).} Naive raw agreement ranks the ladder but cannot diagnose: the sabotaged frontier judge ($+0.35$) is indistinguishable from the honest blind 14B ($+0.37$), yet one inflates its scoreboard ($+0.85\sigma $, regret $0.133$) and the other damages selections (gap $+0.63$, regret $0.324$). The style partial separates them ($+0.59$ vs.\ $-0.21$) and identifies the failure mode in advance. Naive thresholds are also unprincipled ex ante; the audit's verdict is anchored to the sign and axis of the partials.}}{4}{table.caption.7}\protected@file@percent }
\newlabel{tab:h2h}{{1}{4}{\textbf {Naive validation versus the audit, against pressure outcomes (math).} Naive raw agreement ranks the ladder but cannot diagnose: the sabotaged frontier judge ($+0.35$) is indistinguishable from the honest blind 14B ($+0.37$), yet one inflates its scoreboard ($+0.85\sigma $, regret $0.133$) and the other damages selections (gap $+0.63$, regret $0.324$). The style partial separates them ($+0.59$ vs.\ $-0.21$) and identifies the failure mode in advance. Naive thresholds are also unprincipled ex ante; the audit's verdict is anchored to the sign and axis of the partials}{table.caption.7}{}}
