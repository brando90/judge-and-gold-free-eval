\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Why a sixty-label audit can predict gaming.} Comparison-shaped evaluators reward resemblance to a reference, so their scores load on style and reference predictability; verification-shaped evaluators check the solution against something trusted. The audit (bottom) reads which mechanism a judge uses from two partial correlations, and the verdict predicts behavior under optimization pressure (Section~\ref {sec:pressure}).}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:concept}{{1}{2}{\textbf {Why a sixty-label audit can predict gaming.} Comparison-shaped evaluators reward resemblance to a reference, so their scores load on style and reference predictability; verification-shaped evaluators check the solution against something trusted. The audit (bottom) reads which mechanism a judge uses from two partial correlations, and the verdict predicts behavior under optimization pressure (Section~\ref {sec:pressure})}{figure.caption.1}{}}
