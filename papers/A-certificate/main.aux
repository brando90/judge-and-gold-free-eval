\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Verdict stability under label subsampling} (500 resamples per point, fixed verdict rules). \textbf  {Takeaway: convictions are cheap and stable; verdicts near the pass boundary are the ones that need more labels.}}}{7}{figure.caption.13}\protected@file@percent }
\newlabel{fig:stability}{{3}{7}{\textbf {Verdict stability under label subsampling} (500 resamples per point, fixed verdict rules). \textbf {Takeaway: convictions are cheap and stable; verdicts near the pass boundary are the ones that need more labels.}}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Pressure curves: raw hack gap versus best-of-$n$} for every configuration with existing candidate pools, recomputed at $n = 4, 16, 64$ with the pre-registered estimators. Blue: certified (referenced) configurations; orange: failed or convicted ones. \textbf  {Takeaway: within each domain, certified configurations stay low and flat relative to failed ones, but pressure growth is heterogeneous.} Some certified curves do rise (the referenced frontier on math moves $+0.50 \to +0.71$; the referenced 14B on code $+0.30 \to +0.49$), the referenced 1.5B on code climbs to failed-cluster levels ($+0.35 \to +1.46$, the capability-gate miss), and the sabotaged 7B on math declines. The certificate predicts relative position within a domain, not a universal slope.}}{8}{figure.caption.19}\protected@file@percent }
\newlabel{fig:curves}{{4}{8}{\textbf {Pressure curves: raw hack gap versus best-of-$n$} for every configuration with existing candidate pools, recomputed at $n = 4, 16, 64$ with the pre-registered estimators. Blue: certified (referenced) configurations; orange: failed or convicted ones. \textbf {Takeaway: within each domain, certified configurations stay low and flat relative to failed ones, but pressure growth is heterogeneous.} Some certified curves do rise (the referenced frontier on math moves $+0.50 \to +0.71$; the referenced 14B on code $+0.30 \to +0.49$), the referenced 1.5B on code climbs to failed-cluster levels ($+0.35 \to +1.46$, the capability-gate miss), and the sabotaged 7B on math declines. The certificate predicts relative position within a domain, not a universal slope}{figure.caption.19}{}}
