\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Six-axis perturbation battery, per-axis score deltas.} Sensitivity declines with judge scale, referenced arms are flatter than blind at each size (exceptions: the referenced 1.5B, and the 7B bandwagon axis, where the referenced $-0.57$ is significant against a flat blind $-0.03$), and the honest frontier is the flattest of all. Across the ten configurations with both a battery arm and an audited style partial, battery sensitivity rank-correlates with the style partials at Spearman $0.55$ (all-six-axes secondary $0.53$) against the registered bar of $0.5$ (P-B4).}}{23}{table.caption.39}\protected@file@percent }
\newlabel{tab:battery}{{5}{23}{\textbf {Six-axis perturbation battery, per-axis score deltas.} Sensitivity declines with judge scale, referenced arms are flatter than blind at each size (exceptions: the referenced 1.5B, and the 7B bandwagon axis, where the referenced $-0.57$ is significant against a flat blind $-0.03$), and the honest frontier is the flattest of all. Across the ten configurations with both a battery arm and an audited style partial, battery sensitivity rank-correlates with the style partials at Spearman $0.55$ (all-six-axes secondary $0.53$) against the registered bar of $0.5$ (P-B4)}{table.caption.39}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {Zero-label mechanical-axes audit} (machine correctness as target axis, log response length as the ignored-property axis; flag if the length-partial CI excludes zero). The two most corrupted evaluators carry the two largest magnitudes, but the rule also flags two honest referenced passes: a coarse severity screen, not a verdict instrument.}}{23}{table.caption.40}\protected@file@percent }
\newlabel{tab:mech}{{6}{23}{\textbf {Zero-label mechanical-axes audit} (machine correctness as target axis, log response length as the ignored-property axis; flag if the length-partial CI excludes zero). The two most corrupted evaluators carry the two largest magnitudes, but the rule also flags two honest referenced passes: a coarse severity screen, not a verdict instrument}{table.caption.40}{}}
