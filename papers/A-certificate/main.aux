\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Why a small audit can predict gaming.} Comparison-shaped evaluators reward resemblance to a reference, loading on nuisance axes such as style; verification-shaped evaluators check the solution against something trusted. The audit reads which mechanism a judge uses from partial correlations on separated axes, and the verdict predicts behavior under optimization pressure (Section~\ref {sec:pressure}).}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:concept}{{1}{2}{\textbf {Why a small audit can predict gaming.} Comparison-shaped evaluators reward resemblance to a reference, loading on nuisance axes such as style; verification-shaped evaluators check the solution against something trusted. The audit reads which mechanism a judge uses from partial correlations on separated axes, and the verdict predicts behavior under optimization pressure (Section~\ref {sec:pressure})}{figure.caption.1}{}}
