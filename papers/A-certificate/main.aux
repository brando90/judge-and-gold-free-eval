\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Naive validation versus the audit, against pressure outcomes (math; all ten in-domain-audited configurations).} Gap = excess hack gap at best-of-64: how much the judge's own scores inflate relative to true quality, in baseline standard deviations over a permutation null. Regret = accuracy left on the table versus best-possible selection. Bootstrap 95\% CIs in brackets (1.5B-blind CIs omitted: degenerate resamples from concentrated scores). \textbf  {Takeaway: raw agreement conflates the sabotaged frontier judge ($+0.35$) with the honest blind 14B ($+0.37$) although their pressure behavior differs in kind; the style partial separates them ($+0.59$ vs.\ $-0.21$) and identifies the failure mode.}}}{4}{table.caption.8}\protected@file@percent }
\newlabel{tab:h2h}{{1}{4}{\textbf {Naive validation versus the audit, against pressure outcomes (math; all ten in-domain-audited configurations).} Gap = excess hack gap at best-of-64: how much the judge's own scores inflate relative to true quality, in baseline standard deviations over a permutation null. Regret = accuracy left on the table versus best-possible selection. Bootstrap 95\% CIs in brackets (1.5B-blind CIs omitted: degenerate resamples from concentrated scores). \textbf {Takeaway: raw agreement conflates the sabotaged frontier judge ($+0.35$) with the honest blind 14B ($+0.37$) although their pressure behavior differs in kind; the style partial separates them ($+0.59$ vs.\ $-0.21$) and identifies the failure mode.}}{table.caption.8}{}}
\@writefile{toc}{\contentsline {paragraph}{Verdict stability.}{4}{section*.11}\protected@file@percent }
\citation{companionD}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The head-to-head, visualized.} Each point is one audited math configuration; the $y$ axis is its scoreboard inflation under best-of-64 pressure. Left: raw agreement with human soundness places the sabotaged frontier judge inside the failed-blind cluster. Right: the style partial isolates both style-loaded configurations in a sign-anchored conviction region fixed before outcomes. \textbf  {Takeaway: naive validation ranks but cannot diagnose; the audit's nuisance axis separates capable-corrupt from weak-honest.}}}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig:h2h}{{2}{5}{\textbf {The head-to-head, visualized.} Each point is one audited math configuration; the $y$ axis is its scoreboard inflation under best-of-64 pressure. Left: raw agreement with human soundness places the sabotaged frontier judge inside the failed-blind cluster. Right: the style partial isolates both style-loaded configurations in a sign-anchored conviction region fixed before outcomes. \textbf {Takeaway: naive validation ranks but cannot diagnose; the audit's nuisance axis separates capable-corrupt from weak-honest.}}{figure.caption.9}{}}
