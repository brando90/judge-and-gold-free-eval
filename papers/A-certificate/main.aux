\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Why a small audit can predict gaming.} Top and middle: the two evaluator mechanisms; comparison-shaped evaluators reward resemblance to a reference and load on nuisance axes such as style, while verification-shaped evaluators check the solution against something trusted. Bottom: the audit pipeline; a blind labeled set read through partial correlations classifies the mechanism, and the verdict predicts behavior under optimization pressure. \textbf  {Takeaway: evaluator failure has one dominant mechanism, so a small instrument aimed at it can predict gaming before any optimization runs.}}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:concept}{{1}{2}{\textbf {Why a small audit can predict gaming.} Top and middle: the two evaluator mechanisms; comparison-shaped evaluators reward resemblance to a reference and load on nuisance axes such as style, while verification-shaped evaluators check the solution against something trusted. Bottom: the audit pipeline; a blind labeled set read through partial correlations classifies the mechanism, and the verdict predicts behavior under optimization pressure. \textbf {Takeaway: evaluator failure has one dominant mechanism, so a small instrument aimed at it can predict gaming before any optimization runs.}}{figure.caption.1}{}}
