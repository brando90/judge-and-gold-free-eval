\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {The capability gate.} Inflation at $n{=}64$ without (orange) and with (blue) a trusted reference, by judge scale and domain. \textbf  {Takeaway: the reference collapses inflation at every scale on math, where using it means comparing text, and only at 3B and above on code, where using it means executing tests.}}}{11}{figure.caption.25}\protected@file@percent }
\newlabel{fig:gate}{{5}{11}{\textbf {The capability gate.} Inflation at $n{=}64$ without (orange) and with (blue) a trusted reference, by judge scale and domain. \textbf {Takeaway: the reference collapses inflation at every scale on math, where using it means comparing text, and only at 3B and above on code, where using it means executing tests.}}{figure.caption.25}{}}
