\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Prediction ledger.} Registration means internal git timestamps on committed drafts and code, not an external registry, except where a row carries an OSF id: the DPO rerun (now run) and the pending Putnam replication additionally carry external OSF registrations with third-party timestamps (\texttt  {osf.io/jg4ak}, \texttt  {osf.io/axp3s}, both 2026-08-23), while the original registered-era predictions remain internal-timestamp only. Early registered-era rows predate the commit-hash convention and therefore carry no hash; later rows do, and the asymmetry is disclosed rather than repaired.}}{21}{table.caption.37}\protected@file@percent }
\newlabel{tab:ledger}{{3}{21}{\textbf {Prediction ledger.} Registration means internal git timestamps on committed drafts and code, not an external registry, except where a row carries an OSF id: the DPO rerun (now run) and the pending Putnam replication additionally carry external OSF registrations with third-party timestamps (\texttt {osf.io/jg4ak}, \texttt {osf.io/axp3s}, both 2026-08-23), while the original registered-era predictions remain internal-timestamp only. Early registered-era rows predate the commit-hash convention and therefore carry no hash; later rows do, and the asymmetry is disclosed rather than repaired}{table.caption.37}{}}
