\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Pressure curves: raw hack gap versus best-of-$n$} for every configuration with existing candidate pools, recomputed at $n = 4, 16, 64$ with the pre-registered estimators. Blue: certified (referenced) configurations; orange: failed or convicted ones. \textbf  {Takeaway: failed configurations' inflation roughly doubles from $n{=}4$ to $n{=}64$ while certified configurations' rises by less than $0.15\sigma $; the certificate predicts the slope of hacking, not only its endpoint.}}}{7}{figure.caption.18}\protected@file@percent }
\newlabel{fig:curves}{{4}{7}{\textbf {Pressure curves: raw hack gap versus best-of-$n$} for every configuration with existing candidate pools, recomputed at $n = 4, 16, 64$ with the pre-registered estimators. Blue: certified (referenced) configurations; orange: failed or convicted ones. \textbf {Takeaway: failed configurations' inflation roughly doubles from $n{=}4$ to $n{=}64$ while certified configurations' rises by less than $0.15\sigma $; the certificate predicts the slope of hacking, not only its endpoint.}}{figure.caption.18}{}}
