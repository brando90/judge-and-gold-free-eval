\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Best-of-64 selection pressure, 25 judge configurations.} Every configuration that failed static certification is hacked on at least one estimand (large excess gap, large regret, or both), and every configuration certified in-domain resists. The 1.5B-ref cell is the capability gate: the reference rescues the smallest judge on math and does nothing on code. GPT-5.2 was not run unreferenced on math (the -- cells), hence 12 math + 13 code = 25 configurations. Paired no-reference minus referenced contrasts and their bootstrap CIs are in Appendix~\ref {app:cis}.}}{9}{table.caption.13}\protected@file@percent }
\newlabel{tab:bon}{{3}{9}{\textbf {Best-of-64 selection pressure, 25 judge configurations.} Every configuration that failed static certification is hacked on at least one estimand (large excess gap, large regret, or both), and every configuration certified in-domain resists. The 1.5B-ref cell is the capability gate: the reference rescues the smallest judge on math and does nothing on code. GPT-5.2 was not run unreferenced on math (the -- cells), hence 12 math + 13 code = 25 configurations. Paired no-reference minus referenced contrasts and their bootstrap CIs are in Appendix~\ref {app:cis}}{table.caption.13}{}}
