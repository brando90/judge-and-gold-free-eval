\@writefile{toc}{\contentsline {paragraph}{A hacked judge fails in two modes, and capability trades one for the other.}{9}{section*.17}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {The capability gate.} Excess hack gap without (orange) and with (blue) a trusted reference, by judge scale. On math the reference collapses inflation at every scale, including 1.5B. On code, where using the reference means executing tests rather than comparing text, the lever works only at 3B and above, and the frontier judge needs it only for scoreboard honesty (its selection quality is identical either way).}}{10}{figure.caption.15}\protected@file@percent }
\newlabel{fig:gate}{{4}{10}{\textbf {The capability gate.} Excess hack gap without (orange) and with (blue) a trusted reference, by judge scale. On math the reference collapses inflation at every scale, including 1.5B. On code, where using the reference means executing tests rather than comparing text, the lever works only at 3B and above, and the frontier judge needs it only for scoreboard honesty (its selection quality is identical either way)}{figure.caption.15}{}}
