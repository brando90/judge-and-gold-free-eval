\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The compare-vs-verify divide, and why it is auditable.} Top: comparison metrics score a candidate by its resemblance to the reference text, so most of their signal is a property of the reference, not the solution. Middle: verification signals check the solution against a checkable endpoint, so their signal tracks the solution's actual quality. Bottom: a blind sixty-label audit reveals which mechanism an evaluator uses, and the verdict predicts whether it survives optimization pressure (Section~\ref {sec:pressure}).}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:concept}{{1}{2}{\textbf {The compare-vs-verify divide, and why it is auditable.} Top: comparison metrics score a candidate by its resemblance to the reference text, so most of their signal is a property of the reference, not the solution. Middle: verification signals check the solution against a checkable endpoint, so their signal tracks the solution's actual quality. Bottom: a blind sixty-label audit reveals which mechanism an evaluator uses, and the verdict predicts whether it survives optimization pressure (Section~\ref {sec:pressure})}{figure.caption.1}{}}
