\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The two registered sweeps move in opposite directions, as the taxonomy predicts.} Left: up-weighting late reference tokens (the intuitive repair) decays \textsc  {TFA}'s twelve-model ranking signal monotonically past $\gamma {=}1$, through the answer-only-reference null and beyond it. Right: the prefix-repair signal rises monotonically with truncation depth, from a pure difficulty probe ($k{=}0$) to $+0.79$ against human soundness at $k{=}0.75$.}}{7}{figure.caption.10}\protected@file@percent }
\newlabel{fig:sweeps}{{3}{7}{\textbf {The two registered sweeps move in opposite directions, as the taxonomy predicts.} Left: up-weighting late reference tokens (the intuitive repair) decays \tfa 's twelve-model ranking signal monotonically past $\gamma {=}1$, through the answer-only-reference null and beyond it. Right: the prefix-repair signal rises monotonically with truncation depth, from a pure difficulty probe ($k{=}0$) to $+0.79$ against human soundness at $k{=}0.75$}{figure.caption.10}{}}
